<div class="page-header">
  <div>
    <h1 class="page-title">سهامداران</h1>
    <p class="page-subtitle">
      <a href="/legal" class="text-muted-custom text-decoration-none"><i class="bi bi-arrow-right me-1"></i>بازگشت به امور حقوقی</a>
      <span class="ms-3">مجموع سهام: <strong class="text-accent"><%= totalShares %>%</strong></span>
    </p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addShareholderModal">
    <i class="bi bi-plus-lg"></i>سهامدار جدید
  </button>
</div>

<!-- Total Shares Progress -->
<div class="card mb-3 fade-in">
  <div class="card-body">
    <div class="share-bar">
      <span style="font-size:0.835rem; font-weight:600; color:var(--text-heading); min-width:80px;">کل سهام:</span>
      <div class="progress flex-grow-1" style="height:14px;">
        <div class="progress-bar" style="width:<%= Math.min(totalShares, 100) %>%"></div>
      </div>
      <span class="share-pct"><%= totalShares %>%</span>
    </div>
  </div>
</div>

<div class="card fade-in">
  <div class="card-body p-0">
    <% if (shareholders && shareholders.length > 0) { %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>نام</th>
            <th>کد ملی</th>
            <th>درصد سهام</th>
            <th>مبلغ سهام</th>
            <th>سمت</th>
            <th>تلفن</th>
            <th>عملیات</th>
          </tr>
        </thead>
        <tbody>
          <% shareholders.forEach(s => { %>
          <tr>
            <td class="fw-bold"><i class="bi bi-person-circle text-accent me-2"></i><%= s.full_name %></td>
            <td><%= s.national_code || '-' %></td>
            <td>
              <div class="share-bar" style="min-width:140px;">
                <div class="progress flex-grow-1" style="height:8px;">
                  <div class="progress-bar" style="width:<%= s.share_percentage %>%"></div>
                </div>
                <span class="share-pct"><%= s.share_percentage %>%</span>
              </div>
            </td>
            <td><%= (s.share_amount||0).toLocaleString('fa') %></td>
            <td>
              <% const roles = {shareholder:'سهامدار', board_member:'عضو هیئت مدیره', ceo:'مدیرعامل', managing_director:'مدیر اجرایی'}; %>
              <span class="badge bg-info"><%= roles[s.role] || s.role %></span>
            </td>
            <td><%= s.phone || '-' %></td>
            <td>
              <form action="/legal/shareholders/<%= s.id %>/delete" method="POST">
                <button class="btn btn-sm btn-outline-danger" data-confirm="حذف شود؟" title="حذف">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-people"></i></div>
      <h5>سهامداری ثبت نشده</h5>
      <p>از دکمه «سهامدار جدید» برای ثبت اطلاعات سهامداران استفاده کنید</p>
    </div>
    <% } %>
  </div>
</div>

<!-- Add Shareholder Modal -->
<div class="modal fade" id="addShareholderModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/legal/shareholders" method="POST">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>سهامدار جدید</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">نام کامل <span class="text-danger">*</span></label>
            <input type="text" name="full_name" class="form-control" required>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">کد ملی</label>
              <input type="text" name="national_code" class="form-control">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">درصد سهام</label>
              <input type="number" name="share_percentage" class="form-control" step="0.1">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">مبلغ سهام</label>
              <input type="number" name="share_amount" class="form-control">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">سمت</label>
              <select name="role" class="form-select">
                <option value="shareholder">سهامدار</option>
                <option value="board_member">عضو هیئت مدیره</option>
                <option value="ceo">مدیرعامل</option>
                <option value="managing_director">مدیر اجرایی</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">تلفن</label>
              <input type="text" name="phone" class="form-control">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">ایمیل</label>
              <input type="email" name="email" class="form-control">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">آدرس</label>
            <textarea name="address" class="form-control" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>ثبت
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
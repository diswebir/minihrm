<div class="page-header">
  <div>
    <h1 class="page-title">آزمون‌های <%= candidate.first_name %> <%= candidate.last_name %></h1>
    <p class="page-subtitle"><%= candidate.phone %> | <%= candidate.position_title || '' %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/recruitment/<%= candidate.id %>" class="btn btn-outline-info"><i class="bi bi-person me-1"></i>پروفایل</a>
    <a href="/assessments/results" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>بازگشت</a>
  </div>
</div>

<% if (typeof results !== 'undefined' && results.length > 0) { %>
<div class="row">
  <% results.forEach(r => { %>
  <div class="col-md-6 mb-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="mbti-type-badge" style="width:50px;height:50px;font-size:1rem;"><%= r.result_type %></div>
          <div>
            <h5 class="fw-bold mb-0"><%= r.test_name %></h5>
            <small class="text-muted">نتیجه: <strong><%= r.result_type %></strong></small>
          </div>
        </div>
        <div class="d-flex gap-2">
          <a href="/assessments/results/<%= candidate.id %>/<%= r.test_slug %>" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye me-1"></i>جزئیات
          </a>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>
<% } else { %>
<div class="empty-state">
  <i class="bi bi-clipboard-check"></i>
  <h5>هنوز آزمونی انجام نشده</h5>
</div>
<% } %>

<!-- Tests not taken -->
<% if (typeof tests !== 'undefined') { %>
<% const takenIds = results.map(r => r.test_id); %>
<% const notTaken = tests.filter(t => !takenIds.includes(t.id)); %>
<% if (notTaken.length > 0) { %>
<div class="card mt-3">
  <div class="card-header"><i class="bi bi-hourglass me-2"></i>آزمون‌های انجام نشده</div>
  <div class="card-body">
    <div class="d-flex gap-2 flex-wrap">
      <% notTaken.forEach(t => { %>
      <span class="badge bg-secondary px-3 py-2"><%= t.name %></span>
      <% }); %>
    </div>
  </div>
</div>
<% } %>
<% } %>
<div class="page-header">
  <div>
    <h1 class="page-title">نتیجه <%= test.name %></h1>
    <p class="page-subtitle"><%= candidate.first_name %> <%= candidate.last_name %> | <%= candidate.phone %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/recruitment/<%= candidate.id %>" class="btn btn-outline-info"><i class="bi bi-person me-1"></i>پروفایل</a>
    <a href="/assessments/results" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>بازگشت</a>
  </div>
</div>

<div class="row">
  <!-- Result Badge -->
  <div class="col-md-4 mb-3">
    <div class="card text-center">
      <div class="card-body py-4">
        <div class="mbti-type-badge mx-auto mb-3" style="width:80px;height:80px;font-size:1.5rem;"><%= result.result_type %></div>
        <h4 class="fw-bold"><%= result.result_type %></h4>
        <p class="text-muted mb-0"><%= test.name.split(' - ')[0] %></p>
      </div>
    </div>
  </div>

  <!-- Scores -->
  <div class="col-md-8 mb-3">
    <div class="card">
      <div class="card-header"><i class="bi bi-bar-chart me-2"></i>امتیازات</div>
      <div class="card-body">
        <% const scoreEntries = Object.entries(scores); %>
        <% if (scoreEntries.length > 0) { %>
          <% scoreEntries.forEach(([key, value]) => { %>
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span class="fw-bold"><%= key %></span>
              <span class="badge bg-primary"><%= value %></span>
            </div>
            <div class="progress" style="height: 8px;">
              <% const maxScore = test.slug === 'bigfive' || test.slug === 'eq' ? 50 : (test.slug === 'disc' ? 12 : 10); %>
              <div class="progress-bar" style="width: <%= Math.min(Math.round((value / maxScore) * 100), 100) %>%"></div>
            </div>
          </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Full Analysis -->
<div class="card mb-3">
  <div class="card-header"><i class="bi bi-clipboard-data me-2"></i>تحلیل کامل</div>
  <div class="card-body">
    <pre style="white-space: pre-wrap; direction: rtl; font-family: 'Vazirmatn', sans-serif; font-size: 0.95rem; line-height: 2;"><%= result.analysis %></pre>
  </div>
</div>

<% if (result.recommendations) { %>
<div class="card">
  <div class="card-header"><i class="bi bi-lightbulb me-2"></i>پیشنهادات</div>
  <div class="card-body">
    <p class="mb-0"><%= result.recommendations %></p>
  </div>
</div>
<% } %>
<div class="page-header">
  <div><h1 class="page-title">گزارشات</h1></div>
</div>

<!-- Stats Overview -->
<div class="stats-grid mb-3">
  <div class="stat-card">
    <div class="stat-icon primary"><i class="bi bi-people"></i></div>
    <div class="stat-info"><h3><%= recruitmentStats.total %></h3><p>کل متقاضیان</p></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon success"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info"><h3><%= mbtiStats.completed %></h3><p>آزمون MBTI تکمیل شده</p></div>
  </div>
</div>

<!-- Funnel -->
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="card">
      <div class="card-header"><i class="bi bi-funnel me-2"></i>قیف استخدام</div>
      <div class="card-body">
        <div class="funnel-chart">
          <% const funnelData = [
            {label: 'اسکن QR', count: funnel.scanned, color: '#818CF8'},
            {label: 'شروع فرم', count: funnel.started, color: '#6366F1'},
            {label: 'فرم تکمیل', count: funnel.completed, color: '#4F46E5'},
            {label: 'MBTI انجام', count: funnel.mbtiDone, color: '#4338CA'},
            {label: 'تأیید شده', count: funnel.approved, color: '#3730A3'},
            {label: 'استخدام شده', count: funnel.hired, color: '#312E81'},
          ]; %>
          <% const maxFunnel = Math.max(...funnelData.map(f => f.count), 1); %>
          <% funnelData.forEach(f => { %>
          <div class="funnel-step">
            <span class="funnel-label"><%= f.label %></span>
            <div class="funnel-bar-container">
              <div class="funnel-bar" style="width: <%= Math.max((f.count / maxFunnel) * 100, 5) %>%; background: <%= f.color %>;"><%= f.count %></div>
            </div>
            <span class="funnel-count"><%= f.count %></span>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <!-- By Status -->
  <div class="col-md-6 mb-3">
    <div class="card">
      <div class="card-header"><i class="bi bi-pie-chart me-2"></i>توزیع وضعیت</div>
      <div class="card-body">
        <% if (recruitmentStats.byStatus && recruitmentStats.byStatus.length > 0) { %>
        <% const statusColors = {new:'#3B82F6', form_started:'#F59E0B', form_completed:'#10B981', mbti_completed:'#8B5CF6', under_review:'#F97316', interview:'#06B6D4', approved:'#22C55E', rejected:'#EF4444', hired:'#15803D'}; %>
        <% const maxStatus = Math.max(...recruitmentStats.byStatus.map(s => s.count), 1); %>
        <div class="status-bars">
          <% recruitmentStats.byStatus.forEach(s => { %>
          <div class="status-bar-item">
            <span class="status-bar-label"><%= s.status %></span>
            <div class="status-bar-track">
              <div class="status-bar-fill" style="width: <%= Math.max((s.count / maxStatus) * 100, 10) %>%; background: <%= statusColors[s.status] || '#64748B' %>;"><%= s.count %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state"><p class="text-muted">داده‌ای موجود نیست</p></div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- By Position -->
<div class="card mb-3">
  <div class="card-header"><i class="bi bi-briefcase me-2"></i>متقاضیان بر اساس موقعیت شغلی</div>
  <div class="card-body">
    <% if (recruitmentStats.byPosition && recruitmentStats.byPosition.length > 0) { %>
    <div class="row">
      <% recruitmentStats.byPosition.forEach(p => { %>
      <div class="col-md-4 col-6 mb-2">
        <div class="d-flex justify-content-between p-2 rounded bg-light">
          <span><%= p.title %></span>
          <span class="badge bg-primary"><%= p.count %></span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <p class="text-muted text-center mb-0">داده‌ای موجود نیست</p>
    <% } %>
  </div>
</div>

<!-- MBTI Types -->
<% if (mbtiStats.byType && mbtiStats.byType.length > 0) { %>
<div class="card mb-3">
  <div class="card-header"><i class="bi bi-puzzle me-2"></i>توزیع انواع شخصیت MBTI</div>
  <div class="card-body">
    <div class="row">
      <% mbtiStats.byType.forEach(t => { %>
      <div class="col-md-3 col-6 mb-2">
        <div class="d-flex align-items-center gap-2 p-2 rounded bg-light">
          <div class="mbti-type-badge" style="width:40px;height:40px;font-size:0.9rem;"><%= t.mbti_type %></div>
          <div><strong><%= t.count %></strong><small class="text-muted d-block">نفر</small></div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- Recent Activity -->
<div class="card">
  <div class="card-header"><i class="bi bi-activity me-2"></i>آخرین فعالیت‌ها</div>
  <div class="card-body">
    <% if (activityStats.recentLogs && activityStats.recentLogs.length > 0) { %>
    <ul class="activity-list">
      <% activityStats.recentLogs.forEach(a => { %>
      <li class="activity-item">
        <div class="activity-dot <%= a.action %>"></div>
        <div>
          <div class="activity-text"><strong><%= a.user_name || '' %></strong> <%= a.description || a.action %></div>
          <div class="activity-time"><%= new Date(a.created_at).toLocaleDateString('fa-IR') %></div>
        </div>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p class="text-muted text-center mb-0">فعالیتی ثبت نشده</p>
    <% } %>
  </div>
</div>
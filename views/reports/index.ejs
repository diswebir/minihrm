<div class="page-header">
  <div>
    <h1 class="page-title">گزارشات</h1>
    <p class="page-subtitle">آمار و تحلیل‌های سامانه استخدام و منابع انسانی</p>
  </div>
</div>

<!-- Stats Overview -->
<div class="stats-grid">
  <div class="stat-card stat-primary fade-in">
    <div class="stat-icon primary"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <h3><%= recruitmentStats.total %></h3>
      <p>کل متقاضیان</p>
    </div>
  </div>
  <div class="stat-card stat-success fade-in fade-in-delay-1">
    <div class="stat-icon success"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info">
      <h3><%= mbtiStats.completed %></h3>
      <p>آزمون MBTI تکمیل شده</p>
    </div>
  </div>
</div>

<!-- Funnel & Status -->
<div class="widget-grid">
  <!-- Funnel -->
  <div class="widget-card fade-in">
    <div class="widget-header">
      <h6><i class="bi bi-funnel me-2"></i>قیف استخدام</h6>
    </div>
    <div class="widget-body">
      <% const funnelData = [
        {label: 'اسکن QR', count: funnel.scanned, color: 'var(--accent-50)'},
        {label: 'شروع فرم', count: funnel.started, color: 'var(--accent-100)'},
        {label: 'فرم تکمیل', count: funnel.completed, color: 'var(--accent)'},
        {label: 'MBTI انجام', count: funnel.mbtiDone, color: 'var(--accent-hover)'},
        {label: 'تأیید شده', count: funnel.approved, color: 'var(--success)'},
        {label: 'استخدام شده', count: funnel.hired, color: '#047857'},
      ]; %>
      <% const maxFunnel = Math.max(...funnelData.map(f => f.count), 1); %>
      <% funnelData.forEach(f => { %>
      <div class="d-flex align-items-center gap-3 mb-2">
        <span style="min-width:100px; font-size:0.8rem; font-weight:600; color:var(--text-body);"><%= f.label %></span>
        <div class="progress flex-grow-1" style="height:24px; border-radius:var(--radius-sm);">
          <div class="progress-bar" style="width: <%= Math.max((f.count / maxFunnel) * 100, 5) %>%; background: <%= f.color %>; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:0.73rem; font-weight:700; color:white; min-width:24px;">
            <%= f.count %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

  <!-- By Status -->
  <div class="widget-card fade-in fade-in-delay-1">
    <div class="widget-header">
      <h6><i class="bi bi-pie-chart me-2"></i>توزیع وضعیت</h6>
    </div>
    <div class="widget-body">
      <% if (recruitmentStats.byStatus && recruitmentStats.byStatus.length > 0) { %>
      <% const statusColors = {new:'var(--accent)', form_started:'var(--warning)', form_completed:'var(--success)', mbti_completed:'#6D28D9', under_review:'#F97316', interview:'#0891B2', approved:'var(--success)', rejected:'var(--danger)', hired:'#047857'}; %>
      <% const maxStatus = Math.max(...recruitmentStats.byStatus.map(s => s.count), 1); %>
      <% recruitmentStats.byStatus.forEach(s => { %>
      <div class="d-flex align-items-center gap-3 mb-2">
        <span style="min-width:100px; font-size:0.8rem; font-weight:600; color:var(--text-body);"><%= s.status %></span>
        <div class="progress flex-grow-1" style="height:24px; border-radius:var(--radius-sm);">
          <div class="progress-bar" style="width: <%= Math.max((s.count / maxStatus) * 100, 10) %>%; background: <%= statusColors[s.status] || 'var(--navy-400)' %>; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:0.73rem; font-weight:700; color:white; min-width:24px;">
            <%= s.count %>
          </div>
        </div>
      </div>
      <% }); %>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-bar-chart"></i></div>
        <p>داده‌ای موجود نیست</p>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- By Position -->
<div class="card mb-3 fade-in">
  <div class="card-header">
    <span><i class="bi bi-briefcase me-2"></i>متقاضیان بر اساس موقعیت شغلی</span>
  </div>
  <div class="card-body">
    <% if (recruitmentStats.byPosition && recruitmentStats.byPosition.length > 0) { %>
    <div class="info-grid">
      <% recruitmentStats.byPosition.forEach(p => { %>
      <div class="info-item">
        <div class="info-label"><%= p.title %></div>
        <div class="info-value"><%= p.count %> نفر</div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <p class="text-muted-custom text-center mb-0">داده‌ای موجود نیست</p>
    <% } %>
  </div>
</div>

<!-- MBTI Types -->
<% if (mbtiStats.byType && mbtiStats.byType.length > 0) { %>
<div class="card mb-3 fade-in">
  <div class="card-header">
    <span><i class="bi bi-puzzle me-2"></i>توزیع انواع شخصیت MBTI</span>
  </div>
  <div class="card-body">
    <div class="info-grid">
      <% mbtiStats.byType.forEach(t => { %>
      <div class="info-item d-flex align-items-center gap-3">
        <div style="width:44px; height:44px; background:var(--accent-soft); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:800; color:var(--accent); flex-shrink:0;">
          <%= t.mbti_type %>
        </div>
        <div>
          <div class="info-value"><%= t.count %> نفر</div>
          <div class="info-label">نوع <%= t.mbti_type %></div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- Recent Activity -->
<div class="card fade-in">
  <div class="card-header">
    <span><i class="bi bi-activity me-2"></i>آخرین فعالیت‌ها</span>
  </div>
  <div class="card-body">
    <% if (activityStats.recentLogs && activityStats.recentLogs.length > 0) { %>
    <ul class="activity-list">
      <% activityStats.recentLogs.forEach(a => { %>
      <li class="activity-item">
        <div class="activity-dot primary"></div>
        <div class="activity-content">
          <p><strong><%= a.user_name || '' %></strong> <%= a.description || a.action %></p>
          <div class="activity-time"><%= new Date(a.created_at).toLocaleDateString('fa-IR') %></div>
        </div>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-activity"></i></div>
      <p>فعالیتی ثبت نشده</p>
    </div>
    <% } %>
  </div>
</div>
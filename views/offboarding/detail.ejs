<div class="page-header">
  <div>
    <h1 class="page-title">جزئیات تسویه — <%= request.first_name %> <%= request.last_name %></h1>
    <p class="page-subtitle">
      <a href="/offboarding" class="text-muted-custom text-decoration-none"><i class="bi bi-arrow-right me-1"></i>بازگشت به لیست</a>
    </p>
  </div>
</div>

<div class="row">
  <!-- Main Content -->
  <div class="col-md-8 mb-3">
    <!-- Settlement Calculation -->
    <div class="card mb-3 fade-in">
      <div class="card-header">
        <span><i class="bi bi-calculator me-2"></i>محاسبه تسویه</span>
      </div>
      <div class="card-body">
        <form action="/offboarding/<%= request.id %>/settlement" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">سنوات پایان کار</label>
              <input type="number" name="severance_pay" class="form-control" value="<%= request.severance_pay %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">عیدی و پاداش</label>
              <input type="number" name="settlement_amount" class="form-control" value="<%= request.settlement_amount %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">مانده مرخصی</label>
              <input type="number" name="unused_leave_pay" class="form-control" value="<%= request.unused_leave_pay %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">مانده وام</label>
              <input type="number" name="loan_remaining" class="form-control" value="<%= request.loan_remaining %>">
            </div>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>بروزرسانی
          </button>
        </form>

        <div class="alert alert-success mt-3 text-center">
          <h5 style="margin:0;">مبلغ قابل پرداخت: <strong><%= ((request.severance_pay||0)+(request.settlement_amount||0)+(request.unused_leave_pay||0)-(request.loan_remaining||0)).toLocaleString('fa') %> ریال</strong></h5>
        </div>
      </div>
    </div>

    <!-- Exit Checklist -->
    <div class="card fade-in fade-in-delay-1">
      <div class="card-header">
        <span><i class="bi bi-check2-square me-2"></i>چک‌لیست خروج</span>
      </div>
      <div class="card-body">
        <form action="/offboarding/<%= request.id %>/checklist" method="POST">
          <div class="row">
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <input type="checkbox" name="equipment_returned" class="form-check-input" <%= request.equipment_returned ? 'checked' : '' %>>
                <label class="form-check-label">تجهیزات بازگردانده شده</label>
              </div>
            </div>
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <input type="checkbox" name="access_revoked" class="form-check-input" <%= request.access_revoked ? 'checked' : '' %>>
                <label class="form-check-label">دسترسی‌ها لغو شده</label>
              </div>
            </div>
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <input type="checkbox" name="knowledge_transferred" class="form-check-input" <%= request.knowledge_transferred ? 'checked' : '' %>>
                <label class="form-check-label">انتقال دانش انجام شده</label>
              </div>
            </div>
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <input type="checkbox" name="exit_interview_done" class="form-check-input" <%= request.exit_interview_done ? 'checked' : '' %>>
                <label class="form-check-label">مصاحبه خروج انجام شده</label>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-sm mt-2">
            <i class="bi bi-check-lg"></i>بروزرسانی چک‌لیست
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Sidebar Info -->
  <div class="col-md-4 mb-3">
    <div class="card mb-3 fade-in fade-in-delay-2">
      <div class="card-header">
        <span><i class="bi bi-info-circle me-2"></i>اطلاعات درخواست</span>
      </div>
      <div class="card-body">
        <div class="info-grid" style="grid-template-columns:1fr;">
          <div class="info-item">
            <div class="info-label">نوع درخواست</div>
            <div class="info-value">
              <% const types = {resignation:'استعفا', termination:'اخراج', end_contract:'پایان قرارداد', retirement:'بازنشستگی'}; %>
              <%= types[request.request_type] || request.request_type %>
            </div>
          </div>
          <div class="info-item">
            <div class="info-label">آخرین روز کاری</div>
            <div class="info-value"><%= request.last_working_day || '-' %></div>
          </div>
          <div class="info-item">
            <div class="info-label">وضعیت</div>
            <div class="info-value">
              <span class="badge bg-<%= request.status === 'completed' ? 'success' : request.status === 'approved' ? 'info' : 'warning' %>">
                <%= request.status %>
              </span>
            </div>
          </div>
          <% if (request.reason) { %>
          <div class="info-item">
            <div class="info-label">دلیل</div>
            <div class="info-value"><%= request.reason %></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <% if (request.status === 'pending') { %>
    <form action="/offboarding/<%= request.id %>/approve" method="POST" class="mb-2">
      <button class="btn btn-success w-100">
        <i class="bi bi-check-lg"></i>تأیید درخواست
      </button>
    </form>
    <% } %>
    <% if (request.status !== 'completed' && request.status !== 'rejected') { %>
    <form action="/offboarding/<%= request.id %>/complete" method="POST">
      <button class="btn btn-danger w-100" data-confirm="آیا از تکمیل تسویه مطمئن هستید؟">
        <i class="bi bi-check-circle"></i>تکمیل تسویه
      </button>
    </form>
    <% } %>
  </div>
</div>
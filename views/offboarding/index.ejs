<div class="page-header">
  <div>
    <h1 class="page-title">تسویه حساب و ترک کار</h1>
    <p class="page-subtitle">مدیریت درخواست‌های تسویه، خروج و بازنشستگی</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRequestModal">
    <i class="bi bi-plus-lg"></i>درخواست جدید
  </button>
</div>

<div class="card fade-in">
  <div class="card-body p-0">
    <% if (requests && requests.length > 0) { %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>نام</th>
            <th>نوع</th>
            <th>تاریخ آخرین روز</th>
            <th>مبلغ تسویه</th>
            <th>وضعیت</th>
            <th>عملیات</th>
          </tr>
        </thead>
        <tbody>
          <% requests.forEach(r => { %>
          <tr>
            <td class="fw-bold"><%= r.first_name %> <%= r.last_name %></td>
            <td>
              <% const types = {resignation:'استعفا', termination:'اخراج', end_contract:'پایان قرارداد', retirement:'بازنشستگی'}; %>
              <span class="badge bg-info"><%= types[r.request_type] || r.request_type %></span>
            </td>
            <td><%= r.last_working_day || '-' %></td>
            <td class="fw-bold"><%= (r.settlement_amount||0).toLocaleString('fa') %> ریال</td>
            <td>
              <% const sc = {pending:'warning', approved:'info', in_progress:'primary', completed:'success', rejected:'danger'}; %>
              <span class="badge bg-<%= sc[r.status] || 'secondary' %>"><%= r.status %></span>
            </td>
            <td>
              <a href="/offboarding/<%= r.id %>" class="btn btn-sm btn-outline-primary" title="مشاهده">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-box-arrow-right"></i></div>
      <h5>درخواستی ثبت نشده</h5>
      <p>درخواست‌های تسویه حساب در اینجا نمایش داده می‌شوند</p>
    </div>
    <% } %>
  </div>
</div>

<!-- New Request Modal -->
<div class="modal fade" id="newRequestModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/offboarding" method="POST">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-box-arrow-right me-2"></i>درخواست تسویه جدید</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">کارمند <span class="text-danger">*</span></label>
            <select name="user_id" class="form-select" required>
              <option value="">انتخاب کنید</option>
              <% employees.forEach(e => { %>
              <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">نوع درخواست</label>
            <select name="request_type" class="form-select">
              <option value="resignation">استعفا</option>
              <option value="termination">اخراج</option>
              <option value="end_contract">پایان قرارداد</option>
              <option value="retirement">بازنشستگی</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">آخرین روز کاری</label>
            <input type="date" name="last_working_day" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">دلیل</label>
            <textarea name="reason" class="form-control" rows="2" placeholder="دلیل ترک کار..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>ثبت
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
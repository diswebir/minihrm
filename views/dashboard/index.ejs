<div class="page-header">
  <div>
    <h1 class="page-title">داشبورد</h1>
    <p class="page-subtitle">خوش آمدید، <%= user.firstName %> <%= user.lastName %></p>
  </div>
  <div class="d-flex gap-2">
    <% if (['super_admin', 'hr_manager'].includes(userRole)) { %>
      <a href="/recruitment" class="btn btn-primary">
        <i class="bi bi-person-plus"></i>متقاضیان
      </a>
    <% } %>
  </div>
</div>

<% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
<!-- Stats Cards -->
<div class="stats-grid">
  <div class="stat-card stat-primary fade-in">
    <div class="stat-icon primary"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <h3><%= stats.totalCandidates || 0 %></h3>
      <p>کل متقاضیان</p>
    </div>
  </div>
  <div class="stat-card stat-info fade-in fade-in-delay-1">
    <div class="stat-icon info"><i class="bi bi-person-plus"></i></div>
    <div class="stat-info">
      <h3><%= stats.newCandidates || 0 %></h3>
      <p>جدید</p>
    </div>
  </div>
  <div class="stat-card stat-warning fade-in fade-in-delay-2">
    <div class="stat-icon warning"><i class="bi bi-hourglass-split"></i></div>
    <div class="stat-info">
      <h3><%= stats.underReview || 0 %></h3>
      <p>در حال بررسی</p>
    </div>
  </div>
  <div class="stat-card stat-success fade-in fade-in-delay-3">
    <div class="stat-icon success"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info">
      <h3><%= stats.approved || 0 %></h3>
      <p>تأیید شده</p>
    </div>
  </div>
  <div class="stat-card stat-danger fade-in fade-in-delay-4">
    <div class="stat-icon danger"><i class="bi bi-x-circle"></i></div>
    <div class="stat-info">
      <h3><%= stats.rejected || 0 %></h3>
      <p>رد شده</p>
    </div>
  </div>
  <div class="stat-card fade-in fade-in-delay-4">
    <div class="stat-icon secondary"><i class="bi bi-briefcase"></i></div>
    <div class="stat-info">
      <h3><%= stats.activePositions || 0 %></h3>
      <p>موقعیت فعال</p>
    </div>
  </div>
</div>

<!-- Widgets Grid -->
<div class="widget-grid">
  <!-- Recent Candidates -->
  <div class="widget-card fade-in">
    <div class="widget-header">
      <h6><i class="bi bi-clock-history me-2"></i>آخرین متقاضیان</h6>
      <a href="/recruitment" class="btn btn-sm btn-outline-primary">مشاهده همه</a>
    </div>
    <div class="widget-body p-0">
      <% if (recentCandidates && recentCandidates.length > 0) { %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>نام</th>
              <th>موقعیت شغلی</th>
              <th>وضعیت</th>
              <th>تاریخ</th>
            </tr>
          </thead>
          <tbody>
            <% recentCandidates.forEach(c => { %>
            <tr>
              <td>
                <a href="/recruitment/<%= c.id %>" class="no-text-decoration text-accent fw-bold">
                  <%= c.first_name || 'بدون‌نام' %> <%= c.last_name || '' %>
                </a>
              </td>
              <td><%= c.position_title || '-' %></td>
              <td><span class="badge-status badge-<%= c.status %>"><%= c.status %></span></td>
              <td class="text-muted-custom"><%= new Date(c.created_at).toLocaleDateString('fa-IR') %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="bi bi-inbox"></i>
        </div>
        <h5>هنوز متقاضی ثبت‌نام نکرده</h5>
        <p>متقاضیان جدید در اینجا نمایش داده می‌شوند</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="widget-card fade-in fade-in-delay-1">
    <div class="widget-header">
      <h6><i class="bi bi-activity me-2"></i>فعالیت‌های اخیر</h6>
    </div>
    <div class="widget-body">
      <% if (recentActivities && recentActivities.length > 0) { %>
      <ul class="activity-list">
        <% recentActivities.slice(0, 10).forEach(a => { %>
        <li class="activity-item">
          <div class="activity-dot primary"></div>
          <div class="activity-content">
            <p>
              <strong><%= a.first_name || '' %> <%= a.last_name || '' %></strong>
              <%= a.description || a.action %>
            </p>
            <div class="activity-time"><%= new Date(a.created_at).toLocaleDateString('fa-IR') %> <%= new Date(a.created_at).toLocaleTimeString('fa-IR', {hour:'2-digit', minute:'2-digit'}) %></div>
          </div>
        </li>
        <% }); %>
      </ul>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="bi bi-activity"></i>
        </div>
        <h5>هنوز فعالیتی ثبت نشده</h5>
        <p>فعالیت‌های سیستم در اینجا نمایش داده می‌شوند</p>
      </div>
      <% } %>
    </div>
  </div>
</div>

<% } else if (userRole === 'employee') { %>
<!-- Employee Dashboard -->
<div class="stats-grid">
  <div class="stat-card fade-in">
    <div class="stat-icon primary"><i class="bi bi-person"></i></div>
    <div class="stat-info">
      <h3><%= user.firstName %> <%= user.lastName %></h3>
      <p>خوش آمدید به پنل کارمندی</p>
    </div>
  </div>
</div>

<div class="section-grid">
  <a href="/employees" class="section-card fade-in">
    <div class="section-card-icon primary"><i class="bi bi-person-badge"></i></div>
    <h5>پروفایل من</h5>
    <p>مشاهده و ویرایش اطلاعات شخصی</p>
  </a>
  <a href="/training/my-courses" class="section-card fade-in fade-in-delay-1">
    <div class="section-card-icon success"><i class="bi bi-book"></i></div>
    <h5>دوره‌های آموزشی</h5>
    <p>مشاهده دوره‌های آموزشی اختصاص‌یافته</p>
  </a>
  <a href="/payroll/payslips" class="section-card fade-in fade-in-delay-2">
    <div class="section-card-icon warning"><i class="bi bi-cash-stack"></i></div>
    <h5>فیش حقوقی</h5>
    <p>مشاهده فیش‌های حقوقی ماهانه</p>
  </a>
</div>
<% } %>
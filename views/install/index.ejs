<div class="auth-card">
  <div class="auth-header">
    <div class="logo-icon">
      <i class="bi bi-building"></i>
    </div>
    <h2>نصب و راه‌اندازی</h2>
    <p>سامانه مدیریت منابع انسانی MiniHRM</p>
  </div>

  <div class="auth-body">
    <% if (typeof step !== 'undefined') { %>

      <% if (step === 1) { %>
        <!-- Step 1: Company Info -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center gap-2" style="color:var(--accent);">
            <span class="badge rounded-pill" style="background:var(--accent); width:28px; height:28px; display:flex; align-items:center; justify-content:center;">۱</span>
            <span class="fw-bold">اطلاعات شرکت</span>
          </div>
          <div class="d-flex justify-content-center gap-1 mt-2">
            <span style="width:40px; height:4px; background:var(--accent); border-radius:2px;"></span>
            <span style="width:40px; height:4px; background:var(--navy-200); border-radius:2px;"></span>
            <span style="width:40px; height:4px; background:var(--navy-200); border-radius:2px;"></span>
          </div>
        </div>

        <form action="/install/step1" method="POST">
          <div class="mb-3">
            <label class="form-label">نام شرکت <span class="text-danger">*</span></label>
            <input type="text" name="company_name" class="form-control" required placeholder="مثال: شرکت فناوری نوین">
          </div>
          <div class="mb-3">
            <label class="form-label">تلفن شرکت</label>
            <input type="text" name="company_phone" class="form-control" placeholder="۰۲۱-XXXXXXXX">
          </div>
          <div class="mb-3">
            <label class="form-label">ایمیل شرکت</label>
            <input type="email" name="company_email" class="form-control" placeholder="info@company.com">
          </div>
          <div class="mb-3">
            <label class="form-label">آدرس شرکت</label>
            <textarea name="company_address" class="form-control" rows="2" placeholder="آدرس کامل"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-arrow-left"></i>مرحله بعد
          </button>
        </form>

      <% } else if (step === 2) { %>
        <!-- Step 2: Admin Account -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center gap-2" style="color:var(--accent);">
            <span class="badge rounded-pill" style="background:var(--accent); width:28px; height:28px; display:flex; align-items:center; justify-content:center;">۲</span>
            <span class="fw-bold">حساب مدیر سیستم</span>
          </div>
          <div class="d-flex justify-content-center gap-1 mt-2">
            <span style="width:40px; height:4px; background:var(--success); border-radius:2px;"></span>
            <span style="width:40px; height:4px; background:var(--accent); border-radius:2px;"></span>
            <span style="width:40px; height:4px; background:var(--navy-200); border-radius:2px;"></span>
          </div>
        </div>

        <form action="/install/step2" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">نام <span class="text-danger">*</span></label>
              <input type="text" name="first_name" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">نام خانوادگی <span class="text-danger">*</span></label>
              <input type="text" name="last_name" class="form-control" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">نام کاربری <span class="text-danger">*</span></label>
            <input type="text" name="username" class="form-control" required autocomplete="off">
          </div>
          <div class="mb-3">
            <label class="form-label">موبایل</label>
            <input type="text" name="phone" class="form-control" placeholder="۰۹XXXXXXXXX">
          </div>
          <div class="mb-3">
            <label class="form-label">رمز عبور <span class="text-danger">*</span></label>
            <input type="password" name="password" class="form-control" required minlength="6" autocomplete="new-password">
            <div class="form-text">حداقل ۶ کاراکتر</div>
          </div>
          <div class="mb-3">
            <label class="form-label">تکرار رمز عبور <span class="text-danger">*</span></label>
            <input type="password" name="password_confirm" class="form-control" required minlength="6">
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-check-lg"></i>نصب و راه‌اندازی
          </button>
        </form>

      <% } else if (step === 3 && success) { %>
        <!-- Step 3: Complete -->
        <div class="text-center">
          <div class="success-icon" style="width:72px; height:72px; background:var(--success-soft); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:2rem; color:var(--success);">
            <i class="bi bi-check-lg"></i>
          </div>

          <h4 style="font-weight:800; margin-bottom:8px;">تبریک!</h4>
          <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:24px;">سامانه MiniHRM با موفقیت نصب و راه‌اندازی شد.</p>

          <div class="alert alert-info text-start" style="font-size:0.8rem;">
            <h6 style="font-weight:700; margin-bottom:8px;"><i class="bi bi-info-circle me-2"></i>مراحل بعدی:</h6>
            <ul style="margin:0; padding-right:20px;">
              <li>تنظیمات پیامک (IPPanel) را انجام دهید</li>
              <li>بخش‌ها و موقعیت‌های شغلی را تعریف کنید</li>
              <li>فرم استخدام را سفارشی‌سازی کنید</li>
              <li>کاربران جدید ایجاد کنید</li>
            </ul>
          </div>

          <a href="/login" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-left"></i>ورود به سامانه
          </a>
        </div>
      <% } %>

    <% } %>
  </div>
</div>
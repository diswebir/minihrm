<div class="auth-card">
  <div class="auth-header">
    <div class="logo-icon">
      <i class="bi bi-building"></i>
    </div>
    <h2 class="mb-1">MiniHRM</h2>
    <p class="mb-0 opacity-75">سامانه مدیریت منابع انسانی</p>
  </div>
  <div class="auth-body">
    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label">
          <i class="bi bi-person me-1"></i>نام کاربری
        </label>
        <input type="text" name="username" class="form-control" required autofocus placeholder="نام کاربری خود را وارد کنید">
      </div>
      <div class="mb-4">
        <label class="form-label">
          <i class="bi bi-lock me-1"></i>رمز عبور
        </label>
        <input type="password" name="password" class="form-control" required placeholder="رمز عبور">
      </div>
      <button type="submit" class="btn btn-primary w-100">
        <i class="bi bi-box-arrow-in-left me-2"></i>ورود
      </button>
    </form>
  </div>
</div>
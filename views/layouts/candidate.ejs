<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | MiniHRM</title>

  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/candidate.css">
</head>
<body class="candidate-body">
  <!-- Top Progress Bar -->
  <% if (typeof step !== 'undefined' && step !== 'success') { %>
  <div class="candidate-progress-bar">
    <div class="progress-steps">
      <div class="progress-step <%= step === 'landing' || step === 'position' ? 'active' : (step === 'otp' || step === 'form' || step === 'mbti') ? 'completed' : '' %>">
        <div class="step-circle">۱</div>
        <span>انتخاب شغل</span>
      </div>
      <div class="progress-line"></div>
      <div class="progress-step <%= step === 'otp' ? 'active' : (step === 'form' || step === 'mbti') ? 'completed' : '' %>">
        <div class="step-circle">۲</div>
        <span>تأیید موبایل</span>
      </div>
      <div class="progress-line"></div>
      <div class="progress-step <%= step === 'form' ? 'active' : step === 'mbti' ? 'completed' : '' %>">
        <div class="step-circle">۳</div>
        <span>فرم استخدام</span>
      </div>
      <div class="progress-line"></div>
      <div class="progress-step <%= step === 'mbti' ? 'active' : '' %>">
        <div class="step-circle">۴</div>
        <span>آزمون شخصیت</span>
      </div>
    </div>
  </div>
  <% } %>

  <div class="candidate-container">
    <div class="candidate-header">
      <div class="candidate-logo">
        <i class="bi bi-building"></i>
      </div>
      <h1 class="candidate-title"><%= typeof title !== 'undefined' ? title : 'سامانه استخدام' %></h1>
    </div>

    <!-- Flash Messages -->
    <div class="candidate-content">
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle me-2"></i><%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (typeof info !== 'undefined' && info && info.length > 0) { %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <i class="bi bi-info-circle me-2"></i><%= info %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <%- body %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
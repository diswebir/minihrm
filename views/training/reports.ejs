<div class="page-header">
  <div>
    <h1 class="page-title">گزارش آموزش</h1>
    <p class="page-subtitle">
      <a href="/training" class="text-muted-custom text-decoration-none"><i class="bi bi-arrow-right me-1"></i>بازگشت به دوره‌ها</a>
    </p>
  </div>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card stat-primary fade-in">
    <div class="stat-icon primary"><i class="bi bi-book"></i></div>
    <div class="stat-info">
      <h3><%= stats.totalCourses %></h3>
      <p>کل دوره‌ها</p>
    </div>
  </div>
  <div class="stat-card stat-info fade-in fade-in-delay-1">
    <div class="stat-icon info"><i class="bi bi-person-check"></i></div>
    <div class="stat-info">
      <h3><%= stats.totalAssignments %></h3>
      <p>کل اختصاص‌ها</p>
    </div>
  </div>
  <div class="stat-card stat-success fade-in fade-in-delay-2">
    <div class="stat-icon success"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info">
      <h3><%= stats.completed %></h3>
      <p>تکمیل شده</p>
    </div>
  </div>
  <div class="stat-card stat-warning fade-in fade-in-delay-3">
    <div class="stat-icon warning"><i class="bi bi-hourglass"></i></div>
    <div class="stat-info">
      <h3><%= stats.inProgress %></h3>
      <p>در حال انجام</p>
    </div>
  </div>
  <div class="stat-card stat-danger fade-in fade-in-delay-4">
    <div class="stat-icon danger"><i class="bi bi-exclamation-triangle"></i></div>
    <div class="stat-info">
      <h3><%= stats.mandatoryPending %></h3>
      <p>اجباری تکمیل‌نشده</p>
    </div>
  </div>
</div>

<!-- By Category -->
<div class="card fade-in">
  <div class="card-header">
    <span><i class="bi bi-tags me-2"></i>دسته‌بندی دوره‌ها</span>
  </div>
  <div class="card-body">
    <% if (byCategory && byCategory.length > 0) { %>
    <div class="info-grid">
      <% byCategory.forEach(c => { %>
      <div class="info-item">
        <div class="info-label"><%= c.category %></div>
        <div class="info-value"><%= c.count %> دوره</div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-tags"></i></div>
      <p>داده‌ای موجود نیست</p>
    </div>
    <% } %>
  </div>
</div>
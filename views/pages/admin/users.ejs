<%- include('../../partials/header') %>

<div class="flex-between mb-4">
  <p class="text-muted text-sm" style="margin:0">مدیریت کاربران سامانه و سطح دسترسی آن‌ها</p>
  <% if (can('users.manage')) { %>
    <a href="/admin/users/new" class="btn btn-primary"><%- icon('plus', 18) %> کاربر جدید</a>
  <% } %>
</div>

<div class="card">
  <div class="card-body" style="padding-top:12px">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">نام و نام خانوادگی</th>
            <th scope="col">نام کاربری</th>
            <th scope="col">نقش</th>
            <th scope="col">تماس</th>
            <th scope="col">وضعیت</th>
            <th scope="col">آخرین ورود</th>
            <th scope="col">عملیات</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td>
                <div class="flex-center" style="gap:9px">
                  <span class="avatar-sm"><%= (u.full_name || 'ک').charAt(0) %></span>
                  <div>
                    <div class="font-bold"><%= u.full_name %></div>
                    <% if (u.is_super_admin) { %><span class="badge violet">مدیر کل</span><% } %>
                  </div>
                </div>
              </td>
              <td style="direction:ltr;text-align:right"><%= u.username %></td>
              <td><span class="badge primary"><%= u.role_name || 'بدون نقش' %></span></td>
              <td class="text-sm text-muted" style="direction:ltr;text-align:right"><%= u.phone || u.email || '—' %></td>
              <td>
                <% if (u.status === 'active') { %>
                  <span class="badge green">فعال</span>
                <% } else { %>
                  <span class="badge rose">غیرفعال</span>
                <% } %>
              </td>
              <td class="text-sm text-muted"><%= u.last_login_at ? jalaliFull(u.last_login_at) : '—' %></td>
              <td>
                <% if (can('users.manage')) { %>
                  <a href="/admin/users/<%= u.id %>/edit" class="btn btn-soft btn-sm"><%- icon('edit', 15) %> ویرایش</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<div class="page-header">
  <div>
    <h1 class="page-title">رفاهیات</h1>
    <p class="page-subtitle">مدیریت سرویس‌ها، آشپزخانه و نگهبانی</p>
  </div>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card stat-primary fade-in">
    <div class="stat-icon primary"><i class="bi bi-truck"></i></div>
    <div class="stat-info">
      <h3><%= stats.vehicles %></h3>
      <p>وسیله نقلیه</p>
    </div>
  </div>
  <div class="stat-card stat-info fade-in fade-in-delay-1">
    <div class="stat-icon info"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <h3><%= stats.passengers %></h3>
      <p>مسافر سرویس</p>
    </div>
  </div>
  <div class="stat-card stat-success fade-in fade-in-delay-2">
    <div class="stat-icon success"><i class="bi bi-cup-hot"></i></div>
    <div class="stat-info">
      <h3><%= stats.menuItems %></h3>
      <p>آیتم منو</p>
    </div>
  </div>
  <div class="stat-card stat-warning fade-in fade-in-delay-3">
    <div class="stat-icon warning"><i class="bi bi-shield"></i></div>
    <div class="stat-info">
      <h3><%= stats.securityShifts %></h3>
      <p>شیفت نگهبانی</p>
    </div>
  </div>
</div>

<!-- Section Cards -->
<div class="section-grid">
  <a href="/welfare/transport" class="section-card fade-in">
    <div class="section-card-icon primary"><i class="bi bi-truck"></i></div>
    <h5>ایاب و ذهاب</h5>
    <p>مدیریت ناوگان، مسیرها، رانندگان و مسافران سرویس</p>
    <div class="section-card-stat">
      <i class="bi bi-arrow-left"></i>
      <%= stats.vehicles %> وسیله نقلیه فعال
    </div>
  </a>
  <a href="/welfare/kitchen" class="section-card fade-in fade-in-delay-1">
    <div class="section-card-icon success"><i class="bi bi-cup-hot"></i></div>
    <h5>آشپزخانه</h5>
    <p>برنامه‌ریزی منوی هفتگی غذا و مدیریت وعده‌ها</p>
    <div class="section-card-stat">
      <i class="bi bi-arrow-left"></i>
      <%= stats.menuItems %> آیتم منو
    </div>
  </a>
  <a href="/welfare/security" class="section-card fade-in fade-in-delay-2">
    <div class="section-card-icon warning"><i class="bi bi-shield"></i></div>
    <h5>نگهبانی</h5>
    <p>مدیریت شیفت‌های نگهبانی و برنامه‌ریزی نگهبانان</p>
    <div class="section-card-stat">
      <i class="bi bi-arrow-left"></i>
      <%= stats.securityShifts %> شیفت فعال
    </div>
  </a>
</div>
<div class="page-header"><div><h1 class="page-title">آشپزخانه - منوی هفتگی</h1></div>
<a href="/welfare" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>بازگشت</a></div>
<% for (let d = 0; d < 7; d++) { %>
<div class="card mb-2"><div class="card-body">
<div class="d-flex justify-content-between align-items-center">
<h6 class="fw-bold mb-0"><i class="bi bi-calendar-day me-2 text-primary"></i><%= days[d] %></h6>
<div class="d-flex gap-2 flex-wrap">
<% if (grouped[d] && grouped[d].length > 0) { grouped[d].forEach(m => { %>
<span class="badge bg-<%= m.meal_type==='lunch'?'success':'info' %> px-3 py-2">
<%= m.food_name %>
<form action="/welfare/kitchen/menu/<%= m.id %>/delete" method="POST" class="d-inline"><button class="btn-close btn-close-white ms-2" style="font-size:0.6rem;"></button></form>
</span>
<% }); } else { %><span class="text-muted small">تعریف نشده</span><% } %>
</div></div></div></div>
<% } %>

<div class="card mt-3"><div class="card-header">افزودن غذا</div><div class="card-body">
<form action="/welfare/kitchen/menu" method="POST" class="row g-2">
<div class="col-md-3"><select name="day_of_week" class="form-select"><% days.forEach((d,i) => { %><option value="<%= i %>"><%= d %></option><% }); %></select></div>
<div class="col-md-2"><select name="meal_type" class="form-select"><option value="lunch">ناهار</option><option value="breakfast">صبحانه</option><option value="dinner">شام</option></select></div>
<div class="col-md-4"><input type="text" name="food_name" class="form-control" placeholder="نام غذا" required></div>
<div class="col-md-3"><button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus me-1"></i>افزودن</button></div>
</form></div></div>
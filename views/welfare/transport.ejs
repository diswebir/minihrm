<div class="page-header">
  <div>
    <h1 class="page-title">ایاب و ذهاب — ناوگان</h1>
    <p class="page-subtitle">
      <a href="/welfare" class="text-muted-custom text-decoration-none"><i class="bi bi-arrow-right me-1"></i>بازگشت به رفاهیات</a>
    </p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
    <i class="bi bi-plus-lg"></i>وسیله جدید
  </button>
</div>

<div class="section-grid">
  <% if (vehicles && vehicles.length > 0) { vehicles.forEach((v, idx) => { %>
  <div class="vehicle-card fade-in" style="animation-delay: <%= idx * 0.03 %>s;">
    <div class="vehicle-card-header">
      <h6><i class="bi bi-truck me-2 text-accent"></i><%= v.route_name || v.plate_number %></h6>
      <span class="badge bg-info"><%= v.passenger_count %>/<%= v.capacity %> نفر</span>
    </div>
    <div class="vehicle-card-body">
      <div class="detail-row">
        <span class="detail-label">نوع</span>
        <span class="detail-value"><%= v.vehicle_type %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">پلاک</span>
        <span class="detail-value" dir="ltr"><%= v.plate_number %></span>
      </div>
      <% if (v.driver_name) { %>
      <div class="detail-row">
        <span class="detail-label">راننده</span>
        <span class="detail-value"><%= v.driver_name %></span>
      </div>
      <% } %>
      <% if (v.route_description) { %>
      <div class="detail-row">
        <span class="detail-label">مسیر</span>
        <span class="detail-value"><%= v.route_description %></span>
      </div>
      <% } %>
    </div>
    <div class="mt-3">
      <div class="progress mb-2" style="height:8px;">
        <div class="progress-bar" style="width:<%= Math.round((v.passenger_count/v.capacity)*100) %>%"></div>
      </div>
      <a href="/welfare/transport/<%= v.id %>" class="btn btn-sm btn-outline-primary w-100">
        <i class="bi bi-people"></i>مدیریت مسافران
      </a>
    </div>
  </div>
  <% }); } else { %>
  <div class="col-12">
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-truck"></i></div>
      <h5>وسیله نقلیه‌ای ثبت نشده</h5>
      <p>از دکمه «وسیله جدید» برای افزودن وسیله نقلیه استفاده کنید</p>
    </div>
  </div>
  <% } %>
</div>

<!-- Add Vehicle Modal -->
<div class="modal fade" id="addVehicleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/welfare/transport/vehicle" method="POST">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-truck me-2"></i>وسیله نقلیه جدید</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">نوع</label>
              <select name="vehicle_type" class="form-select">
                <option value="van">ون</option>
                <option value="bus">اتوبوس</option>
                <option value="minibus">مینی‌بوس</option>
                <option value="car">خودرو</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">پلاک <span class="text-danger">*</span></label>
              <input type="text" name="plate_number" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">مدل</label>
              <input type="text" name="model" class="form-control">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">ظرفیت</label>
              <input type="number" name="capacity" class="form-control" value="10">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">نام راننده</label>
              <input type="text" name="driver_name" class="form-control">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">تلفن راننده</label>
              <input type="text" name="driver_phone" class="form-control">
            </div>
            <div class="col-12 mb-3">
              <label class="form-label">نام مسیر</label>
              <input type="text" name="route_name" class="form-control" placeholder="مثال: مسیر شمال - ونک">
            </div>
            <div class="col-12 mb-3">
              <label class="form-label">شرح مسیر</label>
              <textarea name="route_description" class="form-control" rows="2" placeholder="ایستگاه‌ها و ساعات حرکت"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>ثبت
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../../partials/header') %>

<%
  function fieldLabel(key) {
    var f = fields.find(function(x){ return x.field_key === key; });
    return f ? f.label : key;
  }
  function val(v) {
    if (v === undefined || v === null || v === '') return '<span class="text-muted">—</span>';
    return v;
  }
  function optionLabel(fieldKey, v) {
    var f = fields.find(function(x){ return x.field_key === fieldKey; });
    if (!f) return v;
    var opts = parseJson(f.options, []);
    var o = opts.find(function(x){ return x.value === v; });
    return o ? o.label : v;
  }
%>

<div class="flex-between mb-4">
  <div class="profile-head">
    <div class="avatar-lg">
      <% if (applicant.photo_path) { %>
        <img src="<%= applicant.photo_path %>" alt="">
      <% } else { %>
        <%= (applicant.first_name || 'م').charAt(0) %>
      <% } %>
    </div>
    <div>
      <h2 style="margin-bottom:4px"><%= (applicant.first_name || '') + ' ' + (applicant.last_name || '') %></h2>
      <div class="flex-center gap-2" style="flex-wrap:wrap">
        <span class="badge primary"><%= applicant.position_title || 'بدون موقعیت' %></span>
        <%
          var sb = statusBadge(applicant.status);
        %>
        <span class="badge <%= sb.color %>"><span class="badge-dot"></span> <%= sb.label %></span>
        <span class="text-xs text-muted">کد پیگیری: <strong><%= applicant.tracking_code %></strong></span>
      </div>
    </div>
  </div>
  <div class="flex-center gap-2 no-print">
    <a href="/hr/applicants" class="btn btn-ghost"><%- icon('arrow', 16) %> بازگشت</a>
    <a href="/hr/applicants/<%= applicant.id %>/print" target="_blank" class="btn btn-soft"><%- icon('print', 16) %> چاپ پرونده</a>
  </div>
</div>

<!-- تغییر وضعیت -->
<% if (canEdit) { %>
<div class="card mb-4 no-print">
  <div class="card-body">
    <div class="flex-between">
      <strong class="text-sm">تغییر وضعیت پرونده:</strong>
      <div class="flex-center gap-2" style="flex-wrap:wrap">
        <% Object.keys(statuses).forEach(function(s) {
          if (s === 'draft') return;
          var st = statuses[s];
        %>
          <button class="btn <%= applicant.status === s ? 'btn-primary' : 'btn-ghost' %> btn-sm"
                  data-action="status-change" data-url="/hr/applicants/<%= applicant.id %>/status" data-status="<%= s %>">
            <%= st.label %>
          </button>
        <% }) %>
      </div>
    </div>
    <div class="help mt-2"><%= statuses[applicant.status] ? statuses[applicant.status].desc : '' %></div>
  </div>
</div>
<% } %>

<!-- تب‌ها -->
<div class="tabs" data-tabs-container="applicant-tabs">
  <button class="tab active" data-tab="info">مشخصات</button>
  <button class="tab" data-tab="exp">سوابق و تحصیلات</button>
  <button class="tab" data-tab="views">دیدگاه‌ها و شرایط</button>
  <% if (mbtiResult && canViewMbti) { %>
    <button class="tab" data-tab="mbti">تحلیل شخصیت</button>
  <% } %>
  <button class="tab" data-tab="notes">نظرات و مصاحبه</button>
  <button class="tab" data-tab="timeline">تاریخچه</button>
</div>

<div id="applicant-tabs">
  <!-- ===== مشخصات ===== -->
  <div data-tab-panel="info">
    <div class="grid grid-2">
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('user') %> مشخصات متقاضی</div></div>
        <div class="card-body">
          <div class="kv"><div class="k">نام و نام خانوادگی</div><div class="v"><%= val((applicant.first_name || '') + ' ' + (applicant.last_name || '')) %></div></div>
          <div class="kv"><div class="k">نام پدر</div><div class="v"><%- val(data.father_name) %></div></div>
          <div class="kv"><div class="k">کد ملی</div><div class="v" style="direction:ltr;text-align:right"><%- val(applicant.national_id) %></div></div>
          <div class="kv"><div class="k">شماره شناسنامه</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.birth_serial) %></div></div>
          <div class="kv"><div class="k">تاریخ تولد</div><div class="v"><%- val(data.birth_date) %></div></div>
          <div class="kv"><div class="k">محل صدور</div><div class="v"><%- val(data.issue_place) %></div></div>
          <div class="kv"><div class="k">جنسیت</div><div class="v"><%- val(optionLabel('gender', data.gender)) %></div></div>
          <div class="kv"><div class="k">دین / مذهب</div><div class="v"><%- val((data.religion || '') + (data.sect ? ' / ' + data.sect : '')) %></div></div>
          <div class="kv"><div class="k">وضعیت تاهل</div><div class="v"><%- val(optionLabel('marital_status', data.marital_status)) %></div></div>
          <div class="kv"><div class="k">تعداد فرزند</div><div class="v"><%- val(data.children_count) %></div></div>
          <% if (data.marital_status === 'married' || data.spouse_name) { %>
            <div class="kv"><div class="k">نام همسر</div><div class="v"><%- val(data.spouse_name) %></div></div>
            <div class="kv"><div class="k">تلفن همسر</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.spouse_phone) %></div></div>
            <div class="kv"><div class="k">شغل همسر</div><div class="v"><%- val(data.spouse_job) %></div></div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('phone') %> تماس و بیمه</div></div>
        <div class="card-body">
          <div class="kv"><div class="k">تلفن همراه</div><div class="v" style="direction:ltr;text-align:right"><%= applicant.phone %></div></div>
          <div class="kv"><div class="k">تلفن ثابت</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.phone_landline) %></div></div>
          <div class="kv"><div class="k">ایمیل</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.email) %></div></div>
          <div class="kv"><div class="k">آدرس</div><div class="v"><%- val(data.address) %></div></div>
          <div class="kv"><div class="k">کد پستی</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.postal_code) %></div></div>
          <div class="kv"><div class="k">سابقه بیمه</div><div class="v"><%- val(optionLabel('has_insurance', data.has_insurance)) %></div></div>
          <div class="kv"><div class="k">سنوات بیمه</div><div class="v"><%- val(data.insurance_years) %></div></div>
          <div class="kv"><div class="k">شماره بیمه</div><div class="v" style="direction:ltr;text-align:right"><%- val(data.insurance_number) %></div></div>
          <div class="kv"><div class="k">نظام وظیفه</div><div class="v"><%- val(optionLabel('military_status', data.military_status)) %></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== سوابق و تحصیلات ===== -->
  <div data-tab-panel="exp" style="display:none">
    <div class="card mb-4">
      <div class="card-header"><div class="card-title"><%- icon('briefcase') %> سوابق کاری</div></div>
      <div class="card-body">
        <% var exps = data.experiences || []; %>
        <% if (!exps.length) { %><div class="text-muted text-sm">سوابقی ثبت نشده است</div><% } %>
        <% exps.forEach(function(e, i) { %>
          <div class="repeater-row" style="background:var(--surface)">
            <div class="form-grid">
              <div class="kv"><div class="k">نام شرکت</div><div class="v"><%- val(e.company) %></div></div>
              <div class="kv"><div class="k">سمت</div><div class="v"><%- val(e.position) %></div></div>
              <div class="kv"><div class="k">تاریخ شروع/پایان</div><div class="v"><%- val(e.period) %></div></div>
              <div class="kv"><div class="k">مدت همکاری</div><div class="v"><%- val(e.duration) %></div></div>
              <div class="kv"><div class="k">آخرین حقوق</div><div class="v"><%- val(e.last_salary) %></div></div>
              <div class="kv"><div class="k">علت قطع همکاری</div><div class="v"><%- val(e.leave_reason) %></div></div>
              <div class="kv"><div class="k">تلفن محل کار</div><div class="v" style="direction:ltr;text-align:right"><%- val(e.work_phone) %></div></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header"><div class="card-title"><%- icon('academic') %> تحصیلات</div></div>
      <div class="card-body">
        <% var edus = data.educations || []; %>
        <% if (!edus.length) { %><div class="text-muted text-sm">سوابقی ثبت نشده است</div><% } %>
        <% edus.forEach(function(e) { %>
          <div class="repeater-row" style="background:var(--surface)">
            <div class="form-grid">
              <div class="kv"><div class="k">مقطع</div><div class="v"><%- val(e.level) %></div></div>
              <div class="kv"><div class="k">رشته</div><div class="v"><%- val(e.major) %></div></div>
              <div class="kv"><div class="k">محل تحصیل</div><div class="v"><%- val(e.institute) %></div></div>
              <div class="kv"><div class="k">سال اخذ مدرک</div><div class="v"><%- val(e.year) %></div></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="grid grid-3">
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('chat') %> زبان‌ها</div></div>
        <div class="card-body">
          <% (data.languages || []).forEach(function(l) { %>
            <div class="flex-between" style="padding:6px 0;border-bottom:1px dashed var(--border)">
              <span class="text-sm font-bold"><%- val(l.language) %></span>
              <span class="badge blue"><%- val(l.level) %></span>
            </div>
          <% }) %>
          <% if (!(data.languages || []).length) { %><div class="text-muted text-sm">—</div><% } %>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('form') %> مهارت‌های نرم‌افزاری</div></div>
        <div class="card-body">
          <% (data.skills || []).forEach(function(l) { %>
            <div class="flex-between" style="padding:6px 0;border-bottom:1px dashed var(--border)">
              <span class="text-sm font-bold"><%- val(l.name) %></span>
              <span class="badge green"><%- val(l.level) %></span>
            </div>
          <% }) %>
          <% if (!(data.skills || []).length) { %><div class="text-muted text-sm">—</div><% } %>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('star') %> دوره‌های آموزشی</div></div>
        <div class="card-body">
          <% (data.courses || []).forEach(function(l) { %>
            <div style="padding:6px 0;border-bottom:1px dashed var(--border)">
              <div class="text-sm font-bold"><%- val(l.title) %></div>
              <div class="text-xs text-muted"><%- val(l.institute) %> — <%- val(l.duration) %></div>
            </div>
          <% }) %>
          <% if (!(data.courses || []).length) { %><div class="text-muted text-sm">—</div><% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== دیدگاه‌ها و شرایط ===== -->
  <div data-tab-panel="views" style="display:none">
    <div class="grid grid-2">
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('chat') %> دیدگاه‌ها و انتظارات</div></div>
        <div class="card-body">
          <div class="field">
            <label class="label"><%= fieldLabel('satisfaction_factors') %></label>
            <div class="text-sm" style="background:var(--bg);padding:12px;border-radius:12px"><%- val(data.satisfaction_factors) %></div>
          </div>
          <div class="field">
            <label class="label"><%= fieldLabel('dissatisfaction_factors') %></label>
            <div class="text-sm" style="background:var(--bg);padding:12px;border-radius:12px"><%- val(data.dissatisfaction_factors) %></div>
          </div>
          <div class="kv"><div class="k">نوع همکاری</div><div class="v"><%- val(optionLabel('cooperation_type', data.cooperation_type)) %></div></div>
          <div class="kv"><div class="k">ساعات پاره‌وقت</div><div class="v"><%- val(data.part_time_hours) %></div></div>
          <div class="kv"><div class="k">حقوق مورد انتظار</div><div class="v"><%- val(data.expected_salary) %></div></div>
          <div class="kv"><div class="k">سمت مورد نظر</div><div class="v"><%- val(data.desired_position) %></div></div>
          <div class="kv"><div class="k">آمادگی شروع</div><div class="v"><%- val(data.start_date) %></div></div>
          <div class="kv"><div class="k">نحوه آشنایی</div><div class="v"><%- val(data.how_found_us) %></div></div>
        </div>
      </div>

      <div>
        <div class="card mb-4">
          <div class="card-header"><div class="card-title"><%- icon('shield') %> شرایط شغل</div></div>
          <div class="card-body">
            <div class="kv"><div class="k">اضافه‌کاری</div><div class="v"><%- val(optionLabel('overtime_ready', data.overtime_ready)) %></div></div>
            <div class="kv"><div class="k">آمادگی مأموریت</div><div class="v">
              <%
                var missions = data.mission_ready || [];
                var mLabels = missions.map(function(m){ return optionLabel('mission_ready', m); });
              %>
              <%- val(mLabels.join('، ')) %>
            </div></div>
            <div class="kv"><div class="k">سلامت جسمی و روانی</div><div class="v"><%- val(optionLabel('health_ok', data.health_ok)) %></div></div>
            <div class="kv"><div class="k">بیماری خاص</div><div class="v"><%- val(data.illness) %></div></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title"><%- icon('users') %> اطلاعات معرف</div></div>
          <div class="card-body">
            <% (data.references || []).forEach(function(r) { %>
              <div class="repeater-row" style="background:var(--surface);padding:12px">
                <div class="flex-between">
                  <div>
                    <div class="font-bold text-sm"><%- val(r.full_name) %></div>
                    <div class="text-xs text-muted"><%- val(r.relation) %></div>
                  </div>
                  <div class="text-sm" style="direction:ltr"><%- val(r.phone) %></div>
                </div>
              </div>
            <% }) %>
            <% if (!(data.references || []).length) { %><div class="text-muted text-sm">معرفی ثبت نشده است</div><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== تحلیل شخصیت ===== -->
  <% if (mbtiResult && canViewMbti) { %>
  <div data-tab-panel="mbti" style="display:none">
    <div class="alert info no-print">
      <%- icon('brain', 20) %>
      <div>
        <strong>نتیجه آزمون شخصیت — محرمانه:</strong>
        این تحلیل صرفاً برای کارشناسان منابع انسانی و مدیریت قابل مشاهده است و به متقاضی نمایش داده نمی‌شود.
        <a href="/hr/mbti/analysis/<%= applicant.id %>" class="font-bold">مشاهده تحلیل کامل و جامع ←</a>
      </div>
    </div>

    <div class="type-hero mb-4">
      <div class="flex-between">
        <div>
          <div class="code"><%= mbtiResult.typeCode %></div>
          <h2 style="color:#fff;margin:12px 0 4px"><%= mbtiResult.typeInfo ? mbtiResult.typeInfo.title : '' %> — <%= mbtiResult.typeInfo ? mbtiResult.typeInfo.nickname : '' %></h2>
          <p style="color:rgba(255,255,255,.85);margin:0"><%= mbtiResult.typeInfo ? mbtiResult.typeInfo.one_liner : '' %></p>
        </div>
        <div class="text-center" style="background:rgba(255,255,255,.15);border-radius:18px;padding:16px 22px">
          <div style="font-size:.78rem;opacity:.85">سازگاری با موقعیت شغلی</div>
          <div style="font-size:1.9rem;font-weight:800"><%= mbtiResult.jobFit && mbtiResult.jobFit.score ? mbtiResult.jobFit.score + '%' : '—' %></div>
        </div>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('chart') %> ابعاد شخصیتی</div></div>
        <div class="card-body">
          <% mbtiResult.dimensions.forEach(function(d) { %>
            <div class="mb-3">
              <div class="flex-between">
                <span class="text-sm font-bold"><%= d.aName %></span>
                <span class="text-sm font-bold"><%= d.bName %></span>
              </div>
              <div class="dim-bar">
                <div class="side a" style="width:<%= d.pctA %>%"><%= d.pctA %>%</div>
                <div class="side b" style="width:<%= d.pctB %>%"><%= d.pctB %>%</div>
              </div>
              <div class="help">
                برنده: <strong><%= d.winnerName %></strong>
                <% if (d.borderline) { %><span class="badge amber">مرزی</span><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><div class="card-title"><%- icon('star') %> نکات کلیدی</div></div>
        <div class="card-body">
          <% if (mbtiResult.typeInfo) { %>
            <h4>نقاط قوت</h4>
            <% (mbtiResult.typeInfo.strengths || []).slice(0, 5).forEach(function(s) { %>
              <div class="flex-center gap-2 text-sm" style="padding:4px 0"><span style="color:var(--mint)">●</span> <%= s %></div>
            <% }) %>
            <h4 class="mt-3">نکات مصاحبه</h4>
            <% (mbtiResult.typeInfo.interview_tips || []).slice(0, 3).forEach(function(s) { %>
              <div class="flex-center gap-2 text-sm" style="padding:4px 0"><span style="color:var(--primary)">●</span> <%= s %></div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ===== نظرات ===== -->
  <div data-tab-panel="notes" style="display:none">
    <% if (canNotes) { %>
    <div class="card mb-4 no-print">
      <div class="card-header"><div class="card-title"><%- icon('edit') %> ثبت نظر جدید</div></div>
      <div class="card-body">
        <form onsubmit="return submitNote(event)">
          <div class="form-grid">
            <div class="field">
              <label class="label">نوع نظر</label>
              <select class="select" name="kind" id="note-kind">
                <option value="interview">نظر مصاحبه‌کننده</option>
                <option value="hr">نظر منابع انسانی</option>
                <option value="management">نظر مدیریت</option>
                <option value="general">یادداشت عمومی</option>
              </select>
            </div>
            <% if (canDecide) { %>
            <div class="field">
              <label class="label">تصمیم (اختیاری)</label>
              <select class="select" name="decision" id="note-decision">
                <option value="">— بدون تصمیم —</option>
                <option value="accept">مناسب برای استخدام</option>
                <option value="review">نیاز به بررسی بیشتر</option>
                <option value="reject">رد صلاحیت</option>
              </select>
            </div>
            <% } %>
          </div>
          <div class="field">
            <label class="label">متن نظر</label>
            <textarea class="textarea" id="note-text" required placeholder="برداشت و نظر خود را بنویسید..."></textarea>
          </div>
          <button class="btn btn-primary">ثبت نظر</button>
        </form>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <% if (!notes.length) { %><div class="text-muted text-sm text-center" style="padding:20px">هنوز نظری ثبت نشده است</div><% } %>
        <% notes.forEach(function(n) {
          var kindLabels = { interview: 'مصاحبه‌کننده', hr: 'منابع انسانی', management: 'مدیریت', general: 'عمومی' };
          var decLabels = { accept: ['مناسب برای استخدام','green'], review: ['بررسی بیشتر','amber'], reject: ['رد صلاحیت','rose'] };
        %>
          <div class="repeater-row" style="background:var(--surface);margin-bottom:10px">
            <div class="flex-between">
              <div class="flex-center gap-2">
                <span class="avatar-sm"><%= (n.user_name || 'س').charAt(0) %></span>
                <div>
                  <div class="font-bold text-sm"><%= n.user_name || 'سیستم' %></div>
                  <div class="text-xs text-muted"><%= kindLabels[n.kind] || n.kind %> — <%= jalaliFull(n.created_at) %></div>
                </div>
              </div>
              <% if (n.decision && decLabels[n.decision]) { %>
                <span class="badge <%= decLabels[n.decision][1] %>"><%= decLabels[n.decision][0] %></span>
              <% } %>
            </div>
            <div class="mt-2 text-sm" style="white-space:pre-wrap"><%= n.note %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- ===== تاریخچه ===== -->
  <div data-tab-panel="timeline" style="display:none">
    <div class="card">
      <div class="card-body">
        <div class="timeline">
          <% events.forEach(function(e) {
            var evLabels = {
              draft_created: 'ایجاد پیش‌نویس', submitted: 'ارسال فرم توسط متقاضی',
              status_change: 'تغییر وضعیت', note_interview: 'نظر مصاحبه', note_hr: 'نظر منابع انسانی',
              note_management: 'نظر مدیریت', note_general: 'یادداشت'
            };
          %>
            <div class="tl-item">
              <div class="tl-title"><%= evLabels[e.event] || e.event %> <%= e.user_name ? '— ' + e.user_name : '' %></div>
              <div class="tl-meta"><%= jalaliFull(e.created_at) %></div>
              <% if (e.detail && e.detail.length < 200) { %>
                <div class="text-xs text-muted"><%= e.detail %></div>
              <% } %>
            </div>
          <% }) %>
          <% if (!events.length) { %><div class="text-muted text-sm">رویدادی ثبت نشده است</div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
async function submitNote(e) {
  e.preventDefault();
  const res = await hrmPost('/hr/applicants/<%= applicant.id %>/note', {
    kind: document.getElementById('note-kind').value,
    decision: document.getElementById('note-decision') ? document.getElementById('note-decision').value : '',
    note: document.getElementById('note-text').value
  });
  if (res.ok) {
    hrmToast(res.message, 'ok');
    setTimeout(function(){ location.reload(); }, 550);
  } else {
    hrmToast(res.message || 'خطا رخ داد', 'err');
  }
  return false;
}
</script>


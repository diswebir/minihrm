<%- include('../../partials/header') %>

<div class="grid grid-4 mb-4">
  <div class="stat-card">
    <div class="stat-icon violet"><%- icon('users', 26) %></div>
    <div>
      <div class="stat-value"><%= faNum(total) %></div>
      <div class="stat-label">کل متقاضیان</div>
    </div>
  </div>
  <% funnel.forEach(function(f, i) {
    var colors = ['sky','amber','violet','mint'];
  %>
    <div class="stat-card">
      <div class="stat-icon <%= colors[i] %>"><%- icon(['file','search','chat','check'][i], 26) %></div>
      <div>
        <div class="stat-value"><%= faNum(f.value) %></div>
        <div class="stat-label"><%= f.label %></div>
      </div>
    </div>
  <% }) %>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header">
      <div class="card-title"><%- icon('chart') %> روند روزانه درخواست‌ها</div>
    </div>
    <div class="card-body">
      <div class="chart-bars" id="trend-bars"></div>
      <div class="text-center text-xs text-muted mt-2">۳۰ روز اخیر</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title"><%- icon('briefcase') %> متقاضیان به تفکیک موقعیت شغلی</div>
    </div>
    <div class="card-body">
      <% var maxPos = Math.max.apply(null, byPosition.map(function(x){ return x.c; }).concat([1])); %>
      <% byPosition.forEach(function(p) { %>
        <div class="bar-row">
          <div class="bar-label"><%= p.title %></div>
          <div class="bar-track">
            <div class="bar-fill sky" style="width:<%= Math.round((p.c / maxPos) * 100) %>%"></div>
          </div>
          <div class="bar-value"><%= p.c %></div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title"><%- icon('form') %> وضعیت پرونده‌ها</div>
    </div>
    <div class="card-body">
      <% byStatus.forEach(function(s) {
        var sb = statusBadge(s.status);
        var maxc = Math.max.apply(null, byStatus.map(function(x){ return x.c; }));
      %>
        <div class="bar-row">
          <div class="bar-label"><%= sb.label %></div>
          <div class="bar-track">
            <div class="bar-fill" style="width:<%= Math.round((s.c / maxc) * 100) %>%"></div>
          </div>
          <div class="bar-value"><%= s.c %></div>
        </div>
      <% }) %>
    </div>
  </div>

  <% if (mbtiDist.length && can('mbti.view')) { %>
  <div class="card">
    <div class="card-header">
      <div class="card-title"><%- icon('brain') %> توزیع تیپ‌های شخصیتی متقاضیان</div>
      <a href="/hr/mbti/types" class="btn btn-soft btn-sm">راهنمای تیپ‌ها</a>
    </div>
    <div class="card-body">
      <% var maxMbti = Math.max.apply(null, mbtiDist.map(function(x){ return x.c; }).concat([1])); %>
      <% mbtiDist.forEach(function(m) { %>
        <div class="bar-row">
          <div class="bar-label"><a href="/hr/mbti/types/<%= m.mbti_type %>"><%= m.mbti_type %></a></div>
          <div class="bar-track">
            <div class="bar-fill mint" style="width:<%= Math.round((m.c / maxMbti) * 100) %>%"></div>
          </div>
          <div class="bar-value"><%= m.c %></div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    renderMiniBars(document.getElementById('trend-bars'), <%- JSON.stringify(trend.map(function(t){ return { label: t.d, value: t.c }; })) %>);
  });
</script>

<%- include('../../partials/footer') %>

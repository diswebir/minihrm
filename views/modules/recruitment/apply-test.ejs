<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="auth-wrap" style="align-items:flex-start;padding-top:34px">
  <div class="auth-card xwide">

    <!-- سربرگ -->
    <div class="flex-between">
      <div class="flex-center">
        <div class="auth-logo" style="margin:0;width:48px;height:48px;border-radius:15px;font-size:1.2rem">HR</div>
        <div>
          <div class="font-bold"><%= company %></div>
          <div class="text-xs text-muted"><%= test.title %></div>
        </div>
      </div>
      <a href="/apply/wizard/mbti" class="btn btn-ghost btn-sm"><%- icon('close', 15) %></a>
    </div>

    <% if (error) { %>
      <div class="alert error mt-3"><%= error %></div>
    <% } %>

    <!-- معرفی آزمون -->
    <div class="mt-3">
      <h2 style="font-size:1.25rem;font-weight:800"><%= test.title %></h2>
      <p class="text-muted mt-1" style="line-height:2"><%= test.intro %></p>
      <div class="alert info">
        <strong>راهنما:</strong> به هر سوال با یکی از گزینه‌های «<%= scaleLabels.join('» تا «') %>» پاسخ دهید.
        پاسخ‌ها محرمانه است و در پنل منابع انسانی بررسی می‌شود.
      </div>
    </div>

    <form method="post" action="/apply/test/<%= test.code %>" id="test-form">
      <% questions.forEach(function (q, i) { %>
        <fieldset class="question-card" style="border:1px solid var(--border, #e7e5f2);border-radius:18px;padding:16px;margin-bottom:14px">
          <legend class="sr-only">سوال <%= q.number %></legend>
          <div class="flex-between" style="align-items:flex-start;gap:10px">
            <div class="flex-center" style="align-items:flex-start;gap:10px">
              <span class="question-no"><%= q.number %></span>
              <div class="font-bold" style="line-height:1.9"><%= q.text %></div>
            </div>
          </div>
          <div class="scale-options mt-2" role="radiogroup" aria-label="پاسخ سوال <%= q.number %>" style="display:flex;flex-wrap:wrap;gap:8px">
            <% scaleLabels.forEach(function (lbl, li) {
                 var val = li + 1;
                 var checked = answersMap[q.number] === val;
            %>
              <label class="option-tile <%= checked ? 'selected' : '' %>" style="flex:1;min-width:110px;text-align:center;padding:10px 8px">
                <input type="radio" name="q_<%= q.number %>" value="<%= val %>" <%= checked ? 'checked' : '' %>>
                <div class="text-xs" style="font-weight:700"><%= lbl %></div>
              </label>
            <% }); %>
          </div>
        </fieldset>
      <% }); %>

      <div class="flex-between mt-3">
        <a href="/apply/wizard/mbti" class="btn btn-ghost">← بازگشت به آزمون‌ها</a>
        <div class="flex-center gap-2">
          <button type="submit" class="btn btn-primary btn-lg">ثبت پاسخ‌ها</button>
        </div>
      </div>
    </form>

  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>

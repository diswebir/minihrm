<%- include('../../partials/header') %>

<div class="flex-between mb-4">
  <div>
    <h1 style="font-size:1.5rem;font-weight:800"><%- icon('spark') %> راهنمای تفسیر آزمون‌ها</h1>
    <p class="text-muted mt-1">ابتدا آزمون مورد نظر را انتخاب کنید تا راهنمای تفسیر نتایج آن نمایش داده شود</p>
  </div>
  <a href="/hr/tests" class="btn btn-soft">نتایج متقاضیان</a>
</div>

<div class="grid grid-2">
  <% cards.forEach(function (c) { %>
    <a href="<%= c.link %>" class="card" style="text-decoration:none;color:inherit">
      <div class="card-header">
        <div class="card-title"><%- icon(c.icon || 'brain') %> <%= c.title %></div>
        <span class="badge">راهنمای تفسیر ←</span>
      </div>
      <div class="card-body">
        <p class="text-muted" style="min-height:44px;margin:0"><%= c.description %></p>
      </div>
    </a>
  <% }); %>
</div>

<%- include('../../partials/footer') %>

<div class="page-header"><div><h1 class="page-title">مدیریت وام‌ها</h1></div>
<div class="d-flex gap-2"><a href="/payroll" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>بازگشت</a>
<% if (['super_admin','hr_manager'].includes(user.role)) { %>
<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLoanModal"><i class="bi bi-plus-lg me-1"></i>وام جدید</button><% } %>
</div></div>
<div class="card"><div class="card-body p-0">
<% if (loans && loans.length > 0) { %>
<table class="table"><thead><tr><th>نام</th><th>نوع</th><th>مبلغ کل</th><th>قسط ماهانه</th><th>اقساط پرداختی</th><th>مانده</th><th>وضعیت</th></tr></thead>
<tbody><% loans.forEach(l => { %>
<tr>
<td class="fw-bold"><%= l.first_name %> <%= l.last_name %></td>
<td><%= l.loan_type === 'cash' ? 'نقدی' : l.loan_type %></td>
<td><%= (l.amount||0).toLocaleString('fa') %></td>
<td><%= (l.monthly_installment||0).toLocaleString('fa') %></td>
<td><%= l.paid_installments %> از <%= l.total_installments %></td>
<td class="fw-bold text-danger"><%= ((l.amount||0) - (l.paid_installments||0) * (l.monthly_installment||0)).toLocaleString('fa') %></td>
<td><span class="badge bg-<%= l.status==='active'?'warning':'success' %>"><%= l.status==='active'?'فعال':'تسویه شده' %></span></td>
</tr><% }); %></tbody></table>
<% } else { %><div class="empty-state"><i class="bi bi-bank"></i><h5>وامی ثبت نشده</h5></div><% } %>
</div></div>

<% if (typeof employees !== 'undefined') { %>
<div class="modal fade" id="addLoanModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
<form action="/payroll/loans" method="POST">
<div class="modal-header"><h5 class="modal-title">وام جدید</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body">
<div class="mb-3"><label class="form-label">کارمند</label><select name="user_id" class="form-select" required><option value="">انتخاب کنید</option><% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }); %></select></div>
<div class="row">
<div class="col-md-6 mb-3"><label class="form-label">نوع وام</label><select name="loan_type" class="form-select"><option value="cash">نقدی</option><option value="housing">مسکن</option><option value="marriage">ازدواج</option></select></div>
<div class="col-md-6 mb-3"><label class="form-label">مبلغ کل</label><input type="number" name="amount" class="form-control" required></div>
<div class="col-md-6 mb-3"><label class="form-label">قسط ماهانه</label><input type="number" name="monthly_installment" class="form-control" required></div>
<div class="col-md-6 mb-3"><label class="form-label">تعداد اقساط</label><input type="number" name="total_installments" class="form-control" required></div>
<div class="col-md-6 mb-3"><label class="form-label">تاریخ شروع</label><input type="date" name="start_date" class="form-control"></div>
</div>
<div class="mb-3"><label class="form-label">توضیحات</label><textarea name="description" class="form-control" rows="2"></textarea></div>
</div>
<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">ثبت</button></div>
</form></div></div></div>
<% } %>
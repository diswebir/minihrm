<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= settings.app_title || 'سامانه مدیریت منابع انسانی' %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app">
  <!-- ================= سایدبار ================= -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <% if (settings.company_logo) { %>
        <img src="<%= settings.company_logo %>" alt="" class="brand-logo" style="object-fit:cover">
      <% } else { %>
        <div class="brand-logo">HR</div>
      <% } %>
      <div>
        <div class="brand-name"><%= settings.app_title || 'مینی HRM' %></div>
        <div class="brand-sub"><%= settings.company_name || '' %></div>
      </div>
    </div>

    <a class="nav-item <%= activeMenu === 'dashboard' ? 'active' : '' %>" href="/dashboard">
      <%- icon('home') %> داشبورد
    </a>

    <!-- بخش استخدام -->
    <% if (enabledModules.find(m => m.code === 'recruitment')) { %>
      <div class="nav-section">استخدام</div>
      <% if (can('applicants.view')) { %>
        <a class="nav-item <%= activeMenu === 'applicants' ? 'active' : '' %>" href="/hr/applicants">
          <%- icon('users') %> متقاضیان
        </a>
      <% } %>
      <% if (can('positions.view')) { %>
        <a class="nav-item <%= activeMenu === 'positions' ? 'active' : '' %>" href="/hr/positions">
          <%- icon('briefcase') %> موقعیت‌های شغلی
        </a>
      <% } %>
      <% if (can('formbuilder.manage')) { %>
        <a class="nav-item <%= activeMenu === 'form-builder' ? 'active' : '' %>" href="/hr/form-builder">
          <%- icon('form') %> طراحی فرم استخدام
        </a>
      <% } %>
      <% if (can('reports.view')) { %>
        <a class="nav-item <%= activeMenu === 'reports' ? 'active' : '' %>" href="/hr/reports">
          <%- icon('chart') %> گزارش استخدام
        </a>
      <% } %>
    <% } %>

    <!-- بخش روانشناسی -->
    <% if (enabledModules.find(m => m.code === 'mbti')) { %>
      <% if (can('mbti.manage') || can('mbti.view')) { %>
        <div class="nav-section">روانشناسی</div>
        <% if (can('mbti.manage')) { %>
          <a class="nav-item <%= activeMenu === 'mbti-questions' ? 'active' : '' %>" href="/hr/mbti/questions">
            <%- icon('brain') %> سوالات آزمون شخصیت
          </a>
        <% } %>
        <% if (can('mbti.view')) { %>
          <a class="nav-item <%= activeMenu === 'mbti-types' ? 'active' : '' %>" href="/hr/mbti/types">
            <%- icon('spark') %> راهنمای تیپ‌های شخصیتی
          </a>
        <% } %>
      <% } %>
    <% } %>

    <!-- مدیریت سامانه -->
    <% if (can('users.view') || can('roles.manage') || can('modules.manage') || can('settings.manage') || can('audit.view')) { %>
      <div class="nav-section">مدیریت سامانه</div>
      <% if (can('users.view')) { %>
        <a class="nav-item <%= activeMenu === 'users' ? 'active' : '' %>" href="/admin/users">
          <%- icon('user') %> کاربران
        </a>
      <% } %>
      <% if (can('roles.manage')) { %>
        <a class="nav-item <%= activeMenu === 'roles' ? 'active' : '' %>" href="/admin/roles">
          <%- icon('key') %> نقش‌ها و دسترسی‌ها
        </a>
      <% } %>
      <% if (can('modules.manage')) { %>
        <a class="nav-item <%= activeMenu === 'modules' ? 'active' : '' %>" href="/admin/modules">
          <%- icon('puzzle') %> ماژول‌ها
        </a>
      <% } %>
      <% if (can('settings.manage')) { %>
        <a class="nav-item <%= activeMenu === 'settings' ? 'active' : '' %>" href="/admin/settings">
          <%- icon('settings') %> تنظیمات
        </a>
      <% } %>
      <% if (can('audit.view')) { %>
        <a class="nav-item <%= activeMenu === 'audit' ? 'active' : '' %>" href="/admin/audit">
          <%- icon('shield') %> گزارش فعالیت‌ها
        </a>
      <% } %>
    <% } %>

    <div class="sidebar-footer">
      <a class="nav-item <%= activeMenu === 'me' ? 'active' : '' %>" href="/me">
        <%- icon('user') %> پورتال من
      </a>
      <a class="nav-item" href="/apply" target="_blank">
        <%- icon('qr') %> صفحه ثبت‌نام متقاضی
      </a>
    </div>
  </aside>

  <!-- ================= محتوا ================= -->
  <div class="main">
    <header class="topbar">
      <button class="menu-toggle" aria-label="منو"><%- icon('menu', 24) %></button>
      <div style="flex:1">
        <h1 style="font-size:1.15rem;margin:0"><%= title %></h1>
      </div>

      <!-- اعلان‌ها -->
      <div class="tooltip-host">
        <button class="btn btn-ghost btn-sm" data-notif-toggle style="position:relative">
          <%- icon('bell', 19) %>
          <% if (unreadCount > 0) { %>
            <span style="position:absolute;top:-4px;left:-4px;background:var(--rose);color:#fff;border-radius:999px;font-size:.66rem;padding:1px 6px;font-weight:700"><%= unreadCount %></span>
          <% } %>
        </button>
        <div class="dropdown" id="notif-dropdown" style="display:none">
          <div class="dropdown-head">اعلان‌ها</div>
          <div style="max-height:320px;overflow:auto;padding:8px">
            <% if (notifications.length === 0) { %>
              <div class="text-muted text-center text-sm" style="padding:18px">اعلان جدیدی ندارید</div>
            <% } %>
            <% notifications.forEach(function(n) { %>
              <a class="notif-item <%= n.read_at ? '' : 'unread' %>" href="<%= n.link || '#' %>">
                <div><%= n.title %></div>
                <div class="text-xs text-muted"><%= n.body %></div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- پروفایل -->
      <a href="/me" class="flex-center" style="gap:10px;color:var(--text)">
        <div class="avatar-sm"><%= (sessionUser && sessionUser.full_name || 'ک').charAt(0) %></div>
        <div class="text-sm" style="line-height:1.5">
          <div class="font-bold"><%= sessionUser ? sessionUser.full_name : '' %></div>
          <div class="text-xs text-muted"><%= sessionUser ? (sessionUser.role_name || '') : '' %></div>
        </div>
      </a>
      <form action="/logout" method="post" style="margin:0">
        <button class="btn btn-ghost btn-sm" title="خروج"><%- icon('logout', 18) %></button>
      </form>
    </header>

    <div class="content">

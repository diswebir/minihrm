<% const userRole = user ? user.role : ''; %>
<% const sidebarModules = (typeof modules !== 'undefined' && modules) ? modules : []; %>

<aside class="sidebar" id="sidebar">
  <!-- Logo -->
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <i class="bi bi-building"></i>
      <span>MiniHRM</span>
    </div>
    <button class="sidebar-close d-lg-none" id="sidebarClose">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav">
    <ul class="nav-list">
      <!-- Dashboard -->
      <li class="nav-item">
        <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
          <i class="bi bi-grid-1x2"></i>
          <span>داشبورد</span>
        </a>
      </li>

      <!-- Users (super_admin, hr_manager) -->
      <% if (['super_admin', 'hr_manager'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/users" class="nav-link <%= currentPath.startsWith('/users') ? 'active' : '' %>">
          <i class="bi bi-people"></i>
          <span>مدیریت کاربران</span>
        </a>
      </li>
      <% } %>

      <!-- Departments (super_admin, hr_manager) -->
      <% if (['super_admin', 'hr_manager'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/departments" class="nav-link <%= currentPath.startsWith('/departments') ? 'active' : '' %>">
          <i class="bi bi-building"></i>
          <span>بخش‌ها</span>
        </a>
      </li>
      <% } %>

      <!-- Positions -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/positions" class="nav-link <%= currentPath.startsWith('/positions') ? 'active' : '' %>">
          <i class="bi bi-briefcase"></i>
          <span>موقعیت‌های شغلی</span>
        </a>
      </li>
      <% } %>

      <!-- Candidates -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/recruitment" class="nav-link <%= currentPath.startsWith('/recruitment') ? 'active' : '' %>">
          <i class="bi bi-person-plus"></i>
          <span>متقاضیان استخدام</span>
        </a>
      </li>
      <% } %>

      <!-- Form Builder -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/form-builder" class="nav-link <%= currentPath.startsWith('/form-builder') ? 'active' : '' %>">
          <i class="bi bi-ui-checks"></i>
          <span>فرم‌ساز</span>
        </a>
      </li>
      <% } %>

      <!-- MBTI -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/mbti" class="nav-link <%= currentPath.startsWith('/mbti') ? 'active' : '' %>">
          <i class="bi bi-puzzle"></i>
          <span>آزمون MBTI</span>
        </a>
      </li>
      <% } %>

      <!-- Assessments -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/assessments/results" class="nav-link <%= currentPath.startsWith('/assessments') ? 'active' : '' %>">
          <i class="bi bi-clipboard-check"></i>
          <span>آزمون‌های استخدامی</span>
        </a>
      </li>
      <% } %>

      <!-- Employees -->
      <li class="nav-item">
        <a href="/employees" class="nav-link <%= currentPath.startsWith('/employees') ? 'active' : '' %>">
          <i class="bi bi-person-badge"></i>
          <span><%= userRole === 'employee' ? 'پروفایل من' : 'کارمندان' %></span>
        </a>
      </li>

      <!-- Training -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/training" class="nav-link <%= currentPath.startsWith('/training') ? 'active' : '' %>">
          <i class="bi bi-book"></i>
          <span>آموزش</span>
        </a>
      </li>
      <% } else if (userRole === 'employee') { %>
      <li class="nav-item">
        <a href="/training/my-courses" class="nav-link <%= currentPath.startsWith('/training') ? 'active' : '' %>">
          <i class="bi bi-book"></i>
          <span>دوره‌های آموزشی من</span>
        </a>
      </li>
      <% } %>

      <!-- Payroll -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/payroll" class="nav-link <%= currentPath.startsWith('/payroll') ? 'active' : '' %>">
          <i class="bi bi-cash-stack"></i>
          <span>حقوق و دستمزد</span>
        </a>
      </li>
      <% } else if (userRole === 'employee') { %>
      <li class="nav-item">
        <a href="/payroll/payslips" class="nav-link <%= currentPath.startsWith('/payroll') ? 'active' : '' %>">
          <i class="bi bi-cash-stack"></i>
          <span>فیش حقوقی من</span>
        </a>
      </li>
      <% } %>

      <!-- Offboarding -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/offboarding" class="nav-link <%= currentPath.startsWith('/offboarding') ? 'active' : '' %>">
          <i class="bi bi-box-arrow-right"></i>
          <span>تسویه و ترک کار</span>
        </a>
      </li>
      <% } %>

      <!-- Welfare -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/welfare" class="nav-link <%= currentPath.startsWith('/welfare') ? 'active' : '' %>">
          <i class="bi bi-heart-pulse"></i>
          <span>رفاهیات</span>
        </a>
      </li>
      <% } %>

      <!-- Legal -->
      <% if (['super_admin', 'hr_manager'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/legal" class="nav-link <%= currentPath.startsWith('/legal') ? 'active' : '' %>">
          <i class="bi bi-shield-check"></i>
          <span>امور حقوقی</span>
        </a>
      </li>
      <% } %>

      <!-- Reports -->
      <% if (['super_admin', 'hr_manager', 'hr_employee'].includes(userRole)) { %>
      <li class="nav-item">
        <a href="/reports" class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>">
          <i class="bi bi-bar-chart"></i>
          <span>گزارشات</span>
        </a>
      </li>
      <% } %>

      <!-- Settings (super_admin only) -->
      <% if (userRole === 'super_admin') { %>
      <li class="nav-item">
        <a href="/settings" class="nav-link <%= currentPath.startsWith('/settings') ? 'active' : '' %>">
          <i class="bi bi-gear"></i>
          <span>تنظیمات</span>
        </a>
      </li>
      <% } %>

      <!-- Divider -->
      <li class="nav-divider"></li>

      <!-- Public Link -->
      <li class="nav-item">
        <a href="/apply" class="nav-link" target="_blank">
          <i class="bi bi-box-arrow-up-left"></i>
          <span>لینک استخدام عمومی</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">
      <a href="/logout" class="nav-link logout-link">
      <i class="bi bi-box-arrow-right"></i>
      <span>خروج</span>
    </a>
  </div>
</aside>
<div class="text-center mb-4">
  <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #8B5CF6, #6366F1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
    <i class="bi bi-clipboard-check" style="font-size: 2rem; color: white;"></i>
  </div>
  <h5>آزمون‌های استخدامی</h5>
  <p class="text-muted small">برای تکمیل فرآیند استخدام، لطفاً آزمون‌های زیر را انجام دهید</p>
</div>

<div class="assessment-cards">
  <% if (typeof tests !== 'undefined' && tests.length > 0) { %>
    <% tests.forEach(test => { %>
    <% const isCompleted = typeof completedMap !== 'undefined' && completedMap[test.id]; %>
    <div class="assessment-card <%= isCompleted ? 'completed' : '' %>">
      <div class="assessment-card-header">
        <div class="assessment-icon">
          <% const icons = {disc:'bi-graph-up', bigfive:'bi-star', eq:'bi-heart', riasec:'bi-briefcase', mbti:'bi-puzzle'}; %>
          <i class="bi <%= icons[test.slug] || 'bi-clipboard' %>"></i>
        </div>
        <div class="assessment-info">
          <h5><%= test.name %></h5>
          <p><%= test.description.substring(0, 80) %>...</p>
        </div>
        <% if (isCompleted) { %>
          <span class="badge bg-success"><i class="bi bi-check-lg"></i> انجام شده</span>
        <% } %>
      </div>
      <div class="assessment-card-footer">
        <span class="text-muted small">
          <i class="bi bi-question-circle me-1"></i><%= test.total_questions %> سؤال
          <span class="mx-2">|</span>
          <i class="bi bi-clock me-1"></i><%= test.time_minutes %> دقیقه
        </span>
        <% if (isCompleted) { %>
          <a href="/apply/assessment/<%= test.slug %>/result" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye me-1"></i>مشاهده نتیجه
          </a>
        <% } else { %>
          <a href="/apply/assessment/<%= test.slug %>" class="btn btn-sm btn-primary">
            <i class="bi bi-play-fill me-1"></i>شروع آزمون
          </a>
        <% } %>
      </div>
    </div>
    <% }); %>
  <% } %>
</div>

<div class="form-navigation mt-4">
  <a href="/apply/form" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-right me-1"></i>بازگشت به فرم
  </a>
  <a href="/apply/success" class="btn btn-success">
    <i class="bi bi-check-lg me-1"></i>تکمیل ثبت‌نام
  </a>
</div>

<style>
.assessment-card {
  background: #f8f9fa;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  padding: 1.25rem;
  margin-bottom: 0.75rem;
  transition: all 0.2s;
}
.assessment-card:hover {
  border-color: #818cf8;
  box-shadow: 0 4px 12px rgba(129,140,248,0.15);
}
.assessment-card.completed {
  border-color: #10b981;
  background: #f0fdf4;
}
.assessment-card-header {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 0.75rem;
}
.assessment-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, #8B5CF6, #6366F1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.3rem;
  flex-shrink: 0;
}
.assessment-card.completed .assessment-icon {
  background: linear-gradient(135deg, #10B981, #059669);
}
.assessment-info h5 {
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 0.25rem;
}
.assessment-info p {
  font-size: 0.85rem;
  color: #64748b;
  margin: 0;
}
.assessment-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0.75rem;
  border-top: 1px solid #e2e8f0;
}
</style>
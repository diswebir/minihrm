<div class="text-center mb-4">
  <h3 style="font-size: 1.1rem; color: var(--text-muted); font-weight: 600;"><%= companyName %></h3>
  <p style="color: var(--text-body); font-size: 0.9rem;">برای شروع فرآیند استخدام، لطفاً اطلاعات زیر را وارد کنید</p>
</div>

<form action="/apply/verify-phone" method="POST">
  <input type="hidden" name="qr_code" value="<%= typeof qrCode !== 'undefined' && qrCode ? qrCode.code : '' %>">

  <!-- Position Selection -->
  <% if (typeof position !== 'undefined' && position) { %>
  <div class="mb-4 p-3 rounded" style="background:var(--accent-soft); border:1px solid var(--accent-50);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-briefcase-fill" style="color:var(--accent);"></i>
      <div>
        <strong style="color:var(--text-heading);"><%= position.title %></strong>
        <% if (position.department_name) { %>
          <span style="color:var(--text-muted); font-size:0.8rem;"> — <%= position.department_name %></span>
        <% } %>
      </div>
    </div>
  </div>
  <input type="hidden" name="job_position_id" value="<%= position.id %>">
  <% } else { %>
  <div class="mb-4">
    <label class="form-label fw-bold">
      <i class="bi bi-briefcase me-1"></i>موقعیت شغلی مورد نظر <span class="text-danger">*</span>
    </label>
    <div class="candidate-positions">
      <% if (typeof positions !== 'undefined' && positions.length > 0) { %>
        <% positions.forEach((p, index) => { %>
        <label class="candidate-position-card <%= index === 0 ? 'selected' : '' %>">
          <input type="radio" name="job_position_id" value="<%= p.id %>" <%= index === 0 ? 'checked' : '' %>> 
          <div class="candidate-position-icon">
            <i class="bi bi-briefcase"></i>
          </div>
          <div class="candidate-position-info">
            <h5><%= p.title %></h5>
            <% if (p.department_name) { %><p><i class="bi bi-building me-1"></i><%= p.department_name %></p><% } %>
          </div>
          <% const types = {full_time:'تمام‌وقت', part_time:'پاره‌وقت', contract:'قراردادی', internship:'کارآموزی'}; %>
          <span class="badge bg-info" style="font-size:0.7rem;"><%= types[p.employment_type] || '' %></span>
        </label>
        <% }); %>
      <% } else { %>
        <div class="alert alert-warning">
          <i class="bi bi-exclamation-triangle"></i>
          در حال حاضر موقعیت شغلی فعالی وجود ندارد
        </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- Phone Input -->
  <div class="mb-4">
    <label class="form-label fw-bold">
      <i class="bi bi-phone me-1"></i>شماره موبایل
    </label>
    <input type="tel" name="phone" class="form-control form-control-lg text-center" dir="ltr"
      required placeholder="09123456789" pattern="09[0-9]{9}" maxlength="11"
      style="font-size: 1.2rem; letter-spacing: 3px;">
    <div class="form-text text-center">کد تأیید به این شماره ارسال خواهد شد</div>
  </div>

  <button type="submit" class="btn btn-primary btn-lg w-100">
    <i class="bi bi-send"></i>دریافت کد تأیید
  </button>
</form>

<div class="text-center mt-4">
  <small style="color:var(--text-light); font-size:0.75rem;">
    <i class="bi bi-shield-check me-1"></i>
    اطلاعات شما محرمانه بوده و فقط توسط واحد منابع انسانی مشاهده می‌شود
  </small>
</div>
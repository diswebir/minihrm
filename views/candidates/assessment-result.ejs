<div class="text-center mb-4">
  <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #10B981, #059669); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
    <i class="bi bi-check-lg" style="font-size: 2.5rem; color: white;"></i>
  </div>
  <h5>نتیجه <%= test.name %></h5>
  <div class="mbti-type-badge mx-auto mt-2" style="font-size: 1.1rem;"><%= result.result_type %></div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <pre style="white-space: pre-wrap; direction: rtl; font-family: 'Vazirmatn', sans-serif; font-size: 0.9rem; line-height: 2; margin: 0;"><%= result.analysis %></pre>
  </div>
</div>

<% if (result.recommendations) { %>
<div class="alert alert-info">
  <i class="bi bi-lightbulb me-2"></i><%= result.recommendations %>
</div>
<% } %>

<div class="text-center text-muted small mt-3">
  <i class="bi bi-shield-check me-1"></i>
  نتایج فقط توسط واحد منابع انسانی قابل مشاهده است
</div>

<div class="form-navigation mt-3">
  <a href="/apply/assessments" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-right me-1"></i>بازگشت به آزمون‌ها
  </a>
  <a href="/apply/success" class="btn btn-success">
    <i class="bi bi-check-lg me-1"></i>تکمیل ثبت‌نام
  </a>
</div>
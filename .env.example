# ═══════════════════════════════════════════════════════════
#  MiniHRM - Environment Configuration
# ═══════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# Session Secret (change this to a random string)
SESSION_SECRET=change-this-to-a-random-secret-key-min-32-chars

# IPPanel SMS Configuration
IPPANEL_API_KEY=your-ippanel-api-key-here
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_PATTERN_CODE=your-pattern-code-here

# Upload limits
MAX_FILE_SIZE_MB=5